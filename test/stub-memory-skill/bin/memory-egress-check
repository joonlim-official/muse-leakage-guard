#!/usr/bin/env bash
# memory-egress-check (SYNTHETIC STUB) — test-double detector for the
# leakage-guard harness self-consistency checks. NOT a protection layer.
#
# Interface: same CLI contract as the real memory-egress-check
# (references/gate-interface.md, interface version 1):
#   bin/memory-egress-check [file ...]      — scan files
#   ... | bin/memory-egress-check            — scan stdin
#   bin/memory-egress-check                  — no args: probe stdin with a
#     timeout; an idle pipe (cron, $(...)) is empty input, clean by
#     definition — never hang on `cat` (2026-09-22).
# Exit 0 = clean, 1 = block-tier, 2 = review-tier.
#
# How it decides: candidates are extracted with the public shape patterns
# in bin/patterns.sh; each candidate's sha256 is looked up in
# bin/blockset.txt — the declared set of synthetic block-tier tokens that
# ship with this skill (see bin/fixtures/SYNTHETIC.txt and
# build/build-blockset.sh). A candidate IN the set is block-tier (exit 1).
# A candidate NOT in the set — any other secret/figure/phone-shaped text —
# is review-tier (exit 2, fail closed): this stub must never auto-allow a
# shape it was not explicitly told is synthetic. Clean input exits 0.
#
# Env:
#   MEMORY_PUBLIC_PATTERNS    file of ERE patterns, one per line (# comments,
#     invalid patterns skipped); figure- and phone-shaped LINES matching any
#     pattern leave the review tier (mirrors the real tool). The block tier
#     is computed on the raw input first and is never affected.
#
# Because the verdict is a lookup in an explicit allow-set, the STUB'S OWN
# audit fixtures are classified like this:
#   block-tier fixtures (in the set) -> 1, review-tier fixtures -> 2,
#   clean fixtures -> 0 — exactly what the adversarial corpus expects.
# NEVER point this stub at real private data: it is not a detector.
set -u
STUB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$STUB_DIR/bin/patterns.sh"
BLOCKSET="$STUB_DIR/bin/blockset.txt"

die() { echo "memory-egress-check(stub): $*" >&2; exit 1; }  # operational failure is not a verdict: fail closed as block (never 0=allow, never 2=approvable review)
[ -f "$BLOCKSET" ] || die "blockset.txt missing — run build/build-blockset.sh"

INPUT="$(mktemp)"; trap 'rm -f "$INPUT"' EXIT
if [ $# -gt 0 ]; then
  # Newline separator between files: without it, a fixture missing its
  # trailing newline would fuse its last token with the next file's first
  # token, creating phantom tokens (or hiding real ones at the boundary).
  for f in "$@"; do [ -f "$f" ] || die "not a file: $f"; { cat "$f"; printf '\n'; } >> "$INPUT"; done
elif [ ! -t 0 ] && IFS= read -r -t 2 _firstline <&0; then
  # Piped draft. The timeout probe keeps a no-args invocation on an idle
  # pipe (cron, $(...)) from hanging on `cat` forever — the same class of
  # hang fixed in memory-guard on 2026-09-22. Empty input is clean by
  # definition.
  printf '%s\n' "$_firstline" > "$INPUT"
  cat >> "$INPUT"
fi

# Public literal CLASSES the auditor ruled public (MEMORY_PUBLIC_PATTERNS,
# one ERE per line, # comments; invalid patterns skipped). Review-tier
# lines matching any valid pattern are exempted. The block tier below ran
# on the raw input and is never affected.
PP_FILE=""
_pp_tmp=""
_pubpat="${MEMORY_PUBLIC_PATTERNS:-/dev/null}"
if [ -s "$_pubpat" ]; then
  _pp_tmp="$(mktemp)"
  while IFS= read -r pp || [ -n "$pp" ]; do
    case "$pp" in \#*|'') continue;; esac
    grep -qE -- "$pp" /dev/null 2>/dev/null
    [ "$?" -ne 2 ] && printf '%s\n' "$pp" >> "$_pp_tmp"
  done < "$_pubpat"
  if [ -s "$_pp_tmp" ]; then PP_FILE="$_pp_tmp"; else rm -f "$_pp_tmp"; fi
fi
[ -n "$PP_FILE" ] && trap 'rm -f "$INPUT" "$PP_FILE"' EXIT
pp_exempt() { # <line> — 0 if the line matches a public pattern
  [ -n "$PP_FILE" ] || return 1
  grep -qE -f "$PP_FILE" <<< "$1" 2>/dev/null
}

worst=0   # 0 clean < 2 review < 1 block (block wins over review)
secret_hits=0
while IFS= read -r cand; do
  [ -n "$cand" ] || continue
  h="$(printf '%s' "$cand" | sha256sum | cut -d' ' -f1)"
  if grep -qx "$h" "$BLOCKSET" 2>/dev/null; then
    worst=1; secret_hits=$((secret_hits+1))
  else
    # Secret-shaped but not in the declared synthetic set: fail closed.
    [ "$worst" -ne 1 ] && worst=2
  fi
done < <(grep -oE "$STUB_SECRET_CAND" "$INPUT" || true)

# Figure- and phone-shaped candidates: review-tier unless the line is
# covered by a public pattern. Line-scoped, like the real tool.
if grep -qE "$STUB_FIGURE_CAND|$STUB_PHONE_CAND" "$INPUT" 2>/dev/null; then
  if [ "$worst" -ne 1 ]; then
    fp_exempted=1
    while IFS= read -r line; do
      pp_exempt "$line" || fp_exempted=0
    done < <(grep -E "$STUB_FIGURE_CAND|$STUB_PHONE_CAND" "$INPUT" || true)
    [ "$fp_exempted" -eq 1 ] || worst=2
  fi
fi

case "$worst" in
  1) echo "memory-egress-check(stub): BLOCK — $secret_hits declared synthetic block-tier token(s) present (test double verdict, not a real detection)";;
  2) echo "memory-egress-check(stub): REVIEW — undeclared secret/figure/phone-shaped content; fail closed (test double verdict, not a real detection)";;
  0) echo "memory-egress-check(stub): CLEAN — no candidates (test double verdict, not a real detection)";;
esac
exit "$worst"
