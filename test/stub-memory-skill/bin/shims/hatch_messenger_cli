#!/usr/bin/env bash
# hatch_messenger_cli (SYNTHETIC STUB shim) — mirrors the interception
# contract of the real messenger shim for harness self-consistency checks.
# Interface version 1 (see ../../../references/gate-interface.md):
#   send|edit [--text TEXT | --text=TEXT] [--text-stdin via stdin]
#       [--cid CID] [--to USER]
# The message (flag and/or stdin) passes bin/egress-gate; on allow, the
# delegate is invoked with the message on stdin (byte-identical replay).
# Everything else passes straight through to the delegate.
# Delegates to $MOCHI_REAL_HATCH_MESSENGER_CLI, else the next
# hatch_messenger_cli on PATH after this shim's own directory.
# This is a test double for harness self-consistency checks — it is not a
# protection layer.
set -u
SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GATE_DIR="$(cd "$SHIM_DIR/.." && pwd)"   # .../bin, where egress-gate lives

REAL="${MOCHI_REAL_HATCH_MESSENGER_CLI:-}"
# Portable canonicalizer: realpath -m when available, else readlink -f, else identity.
canon() {
  if command -v realpath >/dev/null 2>&1; then realpath -m "$1" 2>/dev/null || printf '%s\n' "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then readlink -f "$1"
  else printf '%s\n' "$1"; fi
}
SHIM_CANON="$(canon "$SHIM_DIR")"
if [ -z "$REAL" ]; then
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    [ "$(canon "$d")" = "$SHIM_CANON" ] && continue   # skip our own dir (symlinked spellings included)
    if [ -x "$d/hatch_messenger_cli" ]; then
      [ "$(canon "$d/hatch_messenger_cli")" = "$SHIM_CANON/hatch_messenger_cli" ] && continue  # never delegate to self
      REAL="$d/hatch_messenger_cli"; break
    fi
  done <<< "${PATH//:/$'\n'}"
fi
[ -n "$REAL" ] || { echo "stub-shim: real hatch_messenger_cli not found on PATH" >&2; exit 127; }
# Fail closed: a delegate that resolves to this shim (env override or alias loop) would self-exec forever.
if [ "$(canon "$REAL")" = "$SHIM_CANON/hatch_messenger_cli" ]; then
  echo "stub-shim: delegate resolves to the shim itself — refusing (fail closed)." >&2
  exit 1
fi

case "${1:-}" in
  send|edit)
    text=""; prev=""; ctx="messenger $1 (stub)"
    for a in "$@"; do
      case "$a" in
        --text=*) text="${a#--text=}"; prev="";;
        --cid=*|--to=*) prev="";;
        --cid|--to) prev="";;
        --text) prev=t;;
        --text-stdin) prev="";;
        *) [ "$prev" = "t" ] && text="$a"; prev="";;
      esac
    done
    tmp="$(mktemp)"
    if [ ! -t 0 ]; then cat > "$tmp"; fi
    [ -n "$text" ] && printf '\n%s\n' "$text" >> "$tmp"
    rc=0
    "$GATE_DIR/egress-gate" --content-file "$tmp" --context "$ctx" || rc=$?
    if [ "$rc" -eq 0 ]; then
      "$REAL" "$@" < "$tmp"; rc=$?
    fi
    rm -f "$tmp"
    exit "$rc"
    ;;
esac
exec "$REAL" "$@"
