#!/usr/bin/env bash
# leakage-report — run the leakage audit AND the adversarial suite, then write
# a mobile-friendly HTML outcome report with a one-sentence green/red callout
# per suite. Every number, blurb, and callout is derived from the actual run —
# nothing is hardcoded.
#
# The audit is invoked with MOCHI_AUDIT_MACHINE=1 so it emits machine-readable
# @@-sentinels alongside its human-readable output; the report parses those
# first and only falls back to hardened text scraping for older audit output.
# If the audit output cannot be parsed (format drift, crashed run), no HTML is
# written — a misleading report is worse than none.
#
# Usage: bin/leakage-report [--out PATH] [-h|--help]
# Exit 0 = CLEAN audit and all adversarial cases matched.
# Exit 1 = findings or adversarial mismatches (report still written).
# Exit 2 = usage error, or the audit refused to run (no report written).
# Exit 3 = report generation failed (no trustworthy report written).
set -u
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '2,/^#$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    --out) if [ -z "${2:-}" ] || [ "${2#-}" != "$2" ]; then
             echo "leakage-report: --out requires a PATH argument" >&2; exit 2; fi
           OUT="$2"; shift 2 ;;
    *) echo "usage: bin/leakage-report [--out PATH] [-h|--help]" >&2; exit 2 ;;
  esac
done
if [ -z "$OUT" ]; then
  mkdir -p "$SKILL_DIR/hidden_files/reports"
  OUT="$SKILL_DIR/hidden_files/reports/leakage-validation-$(date +%Y%m%d-%H%M%S)-$$.html"
else
  mkdir -p "$(dirname "$OUT")"
fi
AUD_TMP="$(mktemp)"; ADV_TMP="$(mktemp)"
trap 'rm -f "$AUD_TMP" "$ADV_TMP"' EXIT
# Deterministic narrow layout the fallback parser understands; machine
# sentinels on so the primary parser does not depend on text layout at all.
# Both invocations are bounded: a hung gate must fail this step in minutes,
# not hang it until the CI job timeout (report the hang; exit 3 refuses to
# write HTML from a run that never finished).
MOCHI_REPORT_WIDTH=48 MOCHI_AUDIT_MACHINE=1 \
  timeout -k 10 600 "$SKILL_DIR/bin/leakage-audit" > "$AUD_TMP" 2>&1
RC=$?
if [ "$RC" -eq 124 ]; then
  echo "leakage-report: audit timed out after 600s (gate hung); no report generated." >&2
  exit 3
fi
if [ "$RC" -eq 2 ]; then
  echo "leakage-report: audit refused to run (exit 2); no report generated." >&2
  exit 2
fi
timeout -k 10 600 "$SKILL_DIR/bin/adversarial-run" > "$ADV_TMP" 2>&1
ADV_RC=$?
[ "$ADV_RC" -eq 124 ] && ADV_RC=3  # timed out: runner failed, not "0 mismatches"
python3 - "$AUD_TMP" "$ADV_TMP" "$SKILL_DIR/bin/adversarial-corpus.txt" "$OUT" "$RC" "$ADV_RC" <<'PYEOF'
import html, os, re, sys
aud_src, adv_src, corpus_src, dst, rc, adv_rc = sys.argv[1:5] + [int(sys.argv[5]), int(sys.argv[6])]

def die(msg):
    print(f"leakage-report: {msg}", file=sys.stderr)
    sys.exit(3)

text = open(aud_src, errors="replace").read()
lines = text.splitlines()

def parse_machine(lines):
    suites, cur, meta = [], None, {}
    for ln in lines:
        if not ln.startswith("@@@ "):
            continue
        body = ln[4:]
        if body.startswith("SUITE "):
            _, letter, name = body.split(" ", 2)
            cur = {"letter": letter, "name": name, "checks": [], "notes": [], "ctx": [], "sub": None}
            suites.append(cur)
        elif body.startswith("ENDSUITE "):
            _, letter, p, f, s = body.split()
            hit = [x for x in suites if x["letter"] == letter and x["sub"] is None]
            if hit:
                hit[0]["sub"] = (int(p), int(f), int(s))
        elif body.startswith("CHECK "):
            if cur is None:
                continue
            _, mark, ctext = body.split(" ", 2)
            st = {"PASS": "\u2713", "FAIL": "\u2717", "SKIP": "\u2013"}.get(mark)
            if st:
                cur["checks"].append({"st": st, "text": ctext, "ev": []})
        elif body.startswith("CTX "):
            if cur is None:
                continue
            ctext = body[4:]
            if ctext.startswith("- "):
                cur["notes"].append(ctext[2:])
            elif cur["checks"]:
                cur["checks"][-1]["ev"].append(ctext)
            else:
                cur["ctx"].append(ctext)
        elif body.startswith(("TOTAL ", "VERDICT ", "MODE ", "TARGET ", "TS ", "STUBKIND ")):
            k, v = body.split(" ", 1)
            meta[k] = v
    return suites, meta

def parse_legacy(lines):
    # Hardened fallback for audit output without sentinels (older versions).
    # Detail-section suite headers are 4-space indented ("    D. Gate ...");
    # the 2-space "  D. ..." rows in the Summary section must NOT open new
    # suites (a `seen_summary` guard). Parsing stops attributing text at
    # Summary/Findings so post-suite text is never misattributed, and unknown
    # modes default to UNKNOWN (never SIMULATED).
    suites, cur, meta = [], None, {}
    seen_summary = False
    for ln in lines:
        if re.match(r"^  Summary\s*$", ln):
            seen_summary = True
            cur = None
            continue
        if re.match(r"^  Findings\s*$", ln):
            cur = None
            continue
        m = re.match(r"^    ([A-Z])\. (.+?)\s*$", ln)
        if m and not seen_summary:
            cur = {"letter": m.group(1), "name": m.group(2),
                   "checks": [], "notes": [], "ctx": [], "sub": None}
            suites.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"^  ([✓✗–]) (.*)$", ln)
        if m:
            cur["checks"].append({"st": m.group(1), "text": m.group(2), "ev": []})
            continue
        m = re.match(r"^    (\d+) passed · (\d+) failed · (\d+) skipped$", ln)
        if m:
            cur["sub"] = tuple(map(int, m.groups()))
            continue
        m = re.match(r"^    - (.*)$", ln)
        if m:
            cur["notes"].append(m.group(1))
            continue
        m = re.match(r"^ {4,}(\S.*)$", ln)
        if m and cur["sub"] is None:
            if m.group(1).startswith("- "):
                cur["notes"].append(m.group(1)[2:])
            elif cur["checks"]:
                cur["checks"][-1]["ev"].append(m.group(1))
            else:
                cur["ctx"].append(m.group(1))
            continue
    tm = (re.search(r"^  Total: (\d+) passed \u00b7 (\d+) failed \u00b7 (\d+) skipped", text, re.M)
          or re.search(r"Total: (\d+) passed \u00b7 (\d+) failed \u00b7 (\d+) skipped", text))
    if tm:
        meta["TOTAL"] = " ".join(tm.groups())
    vm = re.search(r"VERDICT: (CLEAN|ATTENTION)", text)
    if vm:
        meta["VERDICT"] = "VERDICT: " + vm.group(1)
    mm = re.search(r"^  mode: (SIMULATED|LIVE-FIRE)", text, re.M)
    if mm:
        meta["MODE"] = mm.group(1)
    tsm = re.search(r"^  (\d{4}-\d{2}-\d{2} \d{2}:\d{2} \w+)", text, re.M)
    if tsm:
        meta["TS"] = tsm.group(1)
    tgm = re.search(r"target: (\S+)", text)
    if tgm:
        meta["TARGET"] = tgm.group(1)
    skm = re.search(r"^  target-kind: (SYNTHETIC STUB)", text, re.M)
    if skm:
        meta["STUBKIND"] = "synthetic-stub"
    return suites, meta

suites, meta = parse_machine(lines)
if not suites:
    suites, meta = parse_legacy(lines)
if not suites:
    die("no suites parsed from audit output (format drift or crashed run) — refusing to write a misleading report")
if any(s["sub"] is None for s in suites):
    die("audit output is missing a suite subtotal line (incomplete run) — refusing to write a misleading report")
if [s["letter"] for s in suites] != ["A", "B", "C", "D", "E"]:
    die("unexpected suite sequence from audit output — refusing to write a misleading report")

total = tuple(map(int, meta["TOTAL"].split())) if "TOTAL" in meta else None
if total is None:
    total = (sum(s["sub"][0] for s in suites), sum(s["sub"][1] for s in suites),
             sum(s["sub"][2] for s in suites))
verdict_word = meta.get("VERDICT", "").split(" ")[1] if meta.get("VERDICT", "").startswith("VERDICT: ") else "?"
if verdict_word not in ("CLEAN", "ATTENTION"):
    verdict_word = "INCOMPLETE"
mode = meta.get("MODE", "UNKNOWN")
if mode not in ("SIMULATED", "LIVE-FIRE"):
    mode = "UNKNOWN"
stub = (meta.get("STUBKIND", "") == "synthetic-stub")
ts = meta.get("TS", "")
tgt = meta.get("TARGET", "")

# ---- adversarial results ----
# Primary: @@@ ADV machine sentinels (emitted by adversarial-run). Fallback:
# the human-readable regexes, for logs predating the sentinels.
adv_text = open(adv_src, errors="replace").read()
adv = None
mismatches = []
sm = re.search(r"^@@@ ADV MATCHED (\d+)/(\d+)", adv_text, re.M)
if sm:
    adv = {"matched": int(sm.group(1)), "total": int(sm.group(2)), "mismatches": []}
    stm = re.search(r"^@@@ ADV TIERS block (\d+)/(\d+) review (\d+)/(\d+) clean (\d+)/(\d+)",
                    adv_text, re.M)
    if stm:
        g = list(map(int, stm.groups()))
        adv["tiers"] = {"block": (g[0], g[1]), "review": (g[2], g[3]), "clean": (g[4], g[5])}
    adv["mismatches"] = re.findall(r"^@@@ ADV MISMATCH (\S+) want=(\S+) got=(\S+)", adv_text, re.M)
    mismatches = adv["mismatches"]
else:
    am = re.search(r"adversarial-run: (\d+)/(\d+) cases matched", adv_text)
    tm = re.search(r"block-tier pass (\d+)/(\d+) \u00b7 review-tier pass (\d+)/(\d+) \u00b7 clean pass (\d+)/(\d+)", adv_text)
    mismatches = re.findall(r"MISMATCH\s+(\S+)\s+want rc=(\d+) got (?:rc=)?(\S+)", adv_text)
    if am:
        adv = {"matched": int(am.group(1)), "total": int(am.group(2)), "mismatches": mismatches}
        if tm:
            g = list(map(int, tm.groups()))
            adv["tiers"] = {"block": (g[0], g[1]), "review": (g[2], g[3]), "clean": (g[4], g[5])}

clean = (verdict_word == "CLEAN" and adv_rc == 0)
badge_word = verdict_word if verdict_word in ("CLEAN", "ATTENTION") else "INCOMPLETE"
if adv_rc != 0 and badge_word == "CLEAN":
    # The audit was green but the adversarial suite mismatched: the badge
    # must not say CLEAN. ATTENTION, with the red F card auto-expanded.
    badge_word = "ATTENTION"

EMAIL_RE = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
def scrub(s):
    return EMAIL_RE.sub("[redacted]", s)

def ci_lower_95(k, n):
    # Exact two-sided 95% Clopper-Pearson lower bound for the perfect k==n
    # case: (alpha/2)^(1/n). Tiers that are imperfect or empty get no number —
    # a made-up interval is worse than none. Small-n fixture sets have wide
    # intervals even at full pass rates; the report states them plainly.
    if n > 0 and k == n:
        return 0.025 ** (1.0 / n)
    return None

def scrub_transcript(s):
    # Raw transcripts can expose local contexts/paths (suite evidence is
    # scrubbed above, but the transcript is verbatim audit output).
    s = EMAIL_RE.sub("[redacted]", s)
    home = os.path.expanduser("~")
    if home and home != "/":
        s = s.replace(home, "~")
    return s

def callout(s):
    n = s["name"].split(" (")[0]
    p, f, sk = s["sub"] or (0, 0, 0)
    if s["letter"] == "F":
        if adv is None:
            return "\U0001F534 Detection performance: adversarial runner failed — see transcript."
        mm, tt = adv["matched"], adv["total"]
        if mm == tt:
            if stub:
                return (f"\U0001F7E3 Stub consistency: {mm}/{tt} corpus cases matched expected verdicts "
                        "against the synthetic test double \u2014 harness self-check, not detector validation.")
            return f"\U0001F7E2 Detection performance: {mm}/{tt} corpus cases matched expected verdicts."
        return f"\U0001F534 Detection performance: {tt - mm} of {tt} corpus cases mismatched."
    if f:
        return f"\U0001F534 {n}: {f} of {p + f + sk} failed — red, needs attention."
    if "residual" in s["name"].lower():
        # Tracked residuals are NOT a protection claim: neutral treatment.
        # Yellow is reserved for approval-gated (protected through approval).
        return (f"\u26AA {n}: {len(s['notes'])} known paths reported and tracked — none silent "
                "(tracked residual, not a protection claim).")
    if p == 0 and f == 0 and sk == 0:
        if s["notes"] or s["ctx"]:
            return f"\u26AA {n}: no checks ran — tracked notes only, not a protection claim."
        # A suite that ran nothing is UNKNOWN — and unknown looks severe,
        # never calm. Treat as unprotected until proven otherwise.
        return f"\U0001F534 {n}: no checks ran — UNKNOWN. Treat as unprotected until proven otherwise."
    if p == 0 and sk:
        why = s["checks"][0]["text"] if s["checks"] else "not run"
        why = re.sub(r"\[.*?\]", "", why).strip()
        return f"\u26AA {n}: skipped — {why}."
    tail = f", {sk} skipped" if sk else ""
    return f"\U0001F7E2 {n}: {p} of {p + sk} green{tail}."

def tested_blurb(s):
    letter, (p, f, sk) = s["letter"], s["sub"]
    total_n = p + f + sk
    if letter == "A":
        blurb = (f"{total_n} installation checks on this machine, just now: gate binaries present, executable and parse-clean; "
                f"send shims shadow the real CLIs on PATH; fixtures present and non-empty; adversarial corpus intact.")
        if stub:
            blurb = "Stub target \u2014 " + blurb.replace("gate binaries present", "stub gate binaries present")
        return blurb
    if letter == "B":
        transport = ("simulated through fake real binaries — nothing was sent" if mode == "SIMULATED"
                     else "live-fire subset over the genuine shim \u2192 gate \u2192 real-binary path to the owner's own accounts" if mode == "LIVE-FIRE"
                     else "transport unverified (mode unknown)")
        return (f"{total_n} red-team checks ({transport}). Block-tier payloads must be refused with rc=1 and the real binary uninvoked; "
                f"review-tier payloads refused without approval (rc=2); clean payloads pass (rc=0).")
    if letter == "C":
        return (f"{total_n} static checks on the protection wiring (agent-manual mandates, briefing policy, cron shim-PATH wiring, "
                f"scenario coverage map, public-repo denylist scan, fixture purity) — {p} passed"
                + (f", {f} failed" if f else "") + (f", {sk} skipped" if sk else "") + ".")
    if letter == "D":
        if any(c["st"] == "\u2013" for c in s["checks"]):
            return "Gate audit log not found — no gated send has been attempted yet; nothing to review."
        n = next((c for c in s["ctx"] if "gate decisions logged" in c), "")
        return f"Gate audit log reviewed{f' ({n})' if n else ''}; blocked attempts and approval overrides surfaced in the evidence."
    if letter == "E":
        return "Residual paths with no technical choke point, tracked openly: " + "; ".join(s["notes"]) + "."
    if letter == "F":
        if adv is None or "tiers" not in adv:
            return "Adversarial runner did not produce figures — see the raw transcript."
        b, r, c = adv["tiers"]["block"], adv["tiers"]["review"], adv["tiers"]["clean"]
        blurb = (f"{adv['matched']}/{adv['total']} corpus cases matched expected verdicts "
                f"(block-tier pass {b[0]}/{b[1]}, review-tier pass {r[0]}/{r[1]}, clean pass {c[0]}/{c[1]}). "
                f"These are pass rates over author-designed regression fixtures — not a real-world sample, "
                f"and not ML recall/precision. Detector check — no sends in either mode.")
        if stub:
            blurb = ("Stub target \u2014 " + blurb.replace("Detector check", "harness self-consistency check against the test double")
                     + " This figure measures the harness against the stub, not real detector quality.")
        return blurb
    return f"{total_n} checks ({p} passed, {f} failed, {sk} skipped)."

# findings: failed checks + adversarial mismatches, auto-expanded.
# Each finding carries its suite letter so the report can link it to the
# failed evidence card.
findings = []
for s in suites:
    for c in s["checks"]:
        if c["st"] == "\u2717":
            ev = scrub(c["ev"][0]) if c["ev"] else ""
            findings.append((f"[{s['letter']}] {scrub(c['text'])}", ev, s["letter"]))
for name, want, got in mismatches:
    findings.append((f"[F] adversarial mismatch {name}: want rc={want}, got rc={got}", "", "F"))

cards = []
def ev_item(c):
    st = c["st"]
    cls = "pass" if st == chr(0x2713) else ("skip" if st == chr(0x2013) else "fail")
    word = "Pass" if st == chr(0x2713) else ("Skipped" if st == chr(0x2013) else "Fail")
    return (f'<li class="{cls}">'
            f'<span class="mark" aria-hidden="true">{st}</span>'
            f'<span class="vh">{word}: </span>'
            f'<span>{html.escape(scrub(c["text"]))}'
            + (f'<br><span class="cev">{html.escape(scrub(c["ev"][0]))}</span>' if c["ev"] else "")
            + "</span></li>")

def ev_list(checks):
    return "".join(ev_item(c) for c in checks)

def tri_state_groups(checks):
    # Suite B only: split evidence into hard-block (rc=1), approval-gated
    # (rc=2), and pass-through (rc=0) so the report never mixes the two
    # protection tiers in one undifferentiated list.
    block, gated, passthru, other = [], [], [], []
    for c in checks:
        m = re.search(r"rc=(\d)", c["text"])
        rc = m.group(1) if m else None
        if rc == "1":
            block.append(c)
        elif rc == "2":
            gated.append(c)
        elif rc == "0":
            passthru.append(c)
        else:
            other.append(c)
    return [("Hard-block evidence \u2014 refused outright (rc=1)", block),
            ("Approval-gated evidence \u2014 refused without explicit approval (rc=2)", gated),
            ("Pass-through evidence \u2014 allowed (rc=0)", passthru),
            ("Other evidence", other)]

def render_card(s, extra=""):
    p, f, sk = s["sub"]
    # Unknown (a suite that ran nothing at all) looks severe, never calm.
    # The stub's self-consistency card gets its own neutral purple — never
    # a green protection card. (The F card carries its content in `extra`,
    # so adv data counts as content for the emptiness test.)
    has_content = s["checks"] or s["notes"] or s["ctx"] or (s["letter"] == "F" and adv is not None)
    if f or (s["letter"] == "F" and adv is None) or not has_content:
        cls = "red"
    elif s["letter"] == "F" and stub and adv is not None:
        cls = "stub"
    elif p:
        cls = "ok"
    else:
        cls = "skip"
    co = callout(s)
    emoji, rest = co.split(" ", 1)
    lid = f"callout-{s['letter']}"
    subtotal = (f'<span class="subtotal">{p} passed \u00b7 {f} failed \u00b7 {sk} skipped</span>'
                if (p + f + sk) else "")
    ctx = "".join(f"<li>{html.escape(scrub(c))}</li>" for c in s["ctx"])
    if s["letter"] == "B" and s["checks"]:
        ev_html = "".join(
            f'<h3 class="ev-label">{html.escape(label)}</h3><ul class="evidence">{ev_list(g)}</ul>'
            for label, g in tri_state_groups(s["checks"]) if g)
    else:
        items = ev_list(s["checks"])
        notes = "".join(f"<li>{html.escape(scrub(n))}</li>" for n in s["notes"])
        n_items = len(s["checks"]) or len(s["notes"]) or len(s["ctx"])
        ev_html = (f'<h3 class="ev-label">Full evidence ({n_items} '
                   f'{"item" if n_items == 1 else "items"})</h3>'
                   f'<ul class="evidence">{items or notes or ctx}</ul>') if n_items else ""
    cards.append(f"""
    <section class="card {cls}" id="card-{s['letter']}" aria-labelledby="{lid}">
      <button class="card-head" aria-expanded="false" aria-controls="detail-{s['letter']}">
        <span class="head-text">
          <span class="callout" id="{lid}" role="heading" aria-level="2"><span aria-hidden="true">{emoji}</span> {html.escape(rest)}</span>
          {subtotal}
        </span>
        <span class="chev" aria-hidden="true">\u25b8</span>
      </button>
      <div class="detail" id="detail-{s['letter']}" role="region" aria-labelledby="{lid}" hidden>
        <p class="tested">{html.escape(tested_blurb(s))}</p>
        {('<p class="ops-label">Operational notes</p><ul class="notes">' + ctx + "</ul>") if ctx and s["letter"] != "D" else ""}
        {extra}
        {ev_html}
      </div>
    </section>""")

for s in suites:
    render_card(s)

# adversarial card F
fletter = "F"
fsub = (adv["matched"], adv["total"] - adv["matched"], 0) if adv else (0, 0, 0)
fsuite = {"letter": "F", "name": "Detection performance (adversarial corpus)", "checks": [], "notes": [], "ctx": [], "sub": fsub}
cases_html = ""
if adv:
    rows = []
    cases = []  # (name, want, got) — feeds the confusion matrix below
    for ln in open(corpus_src, errors="replace").read().splitlines():
        ln = ln.strip()
        if not ln or ln.startswith("#"):
            continue
        parts = ln.split("|", 2)
        if len(parts) != 3:
            continue
        name, want = parts[0], parts[1]
        mm = next((m for m in mismatches if m[0] == name), None)
        got = mm[2] if mm else want
        okc = got == want
        cases.append((name, want, got))
        mark = "\u2713" if okc else "\u2717"
        rows.append(f'<tr><th scope="row">{html.escape(name)}</th><td>rc={html.escape(want)}</td>'
                    f'<td>rc={html.escape(got)}</td>'
                    f'<td class="{"cok" if okc else "cbad"}"><span aria-hidden="true">{mark}</span>'
                    f'<span class="vh">{"matched" if okc else "mismatched"}</span></td></tr>')
    tier_line = ""
    ci_line = ""
    if "tiers" in adv:
        b, r, c = adv["tiers"]["block"], adv["tiers"]["review"], adv["tiers"]["clean"]
        tier_line = (f'<p class="tiers">block-tier pass {b[0]}/{b[1]} \u00b7 review-tier pass {r[0]}/{r[1]} '
                     f'\u00b7 clean pass {c[0]}/{c[1]}</p>')
        # Exact 95% CI context: small-n fixture sets have wide intervals even
        # at full pass rates. Stated plainly so a 19/19 is never read as
        # "certain".
        ci_bits = []
        for label, (k, n) in (("block-tier", b), ("review-tier", r), ("clean", c)):
            lb = ci_lower_95(k, n)
            ci_bits.append(f"{label} \u2265 {lb:.2f} ({k}/{n})" if lb is not None
                           else f"{label}: interval not computed ({k}/{n})")
        ci_line = ('<p class="tiers ci">Exact 95% CI lower bounds (Clopper-Pearson): '
                   + " \u00b7 ".join(ci_bits) + ".</p>")
    # 3x3 expected-vs-actual exit-code confusion matrix.
    order = ["1", "2", "0"]
    wnames = {"1": "block-tier (want rc=1)", "2": "review-tier (want rc=2)", "0": "clean (want rc=0)"}
    gnames = {"1": "got rc=1", "2": "got rc=2", "0": "got rc=0"}
    matrix = {(w, g): 0 for w in order for g in order}
    nonstd = [f"{n} (want rc={w}, got {g})" for n, w, g in cases
              if w not in order or g not in order]
    for n, w, g in cases:
        if w in order and g in order:
            matrix[(w, g)] += 1
    mrows = "".join(
        f'<tr><th scope="row">{html.escape(wnames[w])}</th>'
        + "".join(f"<td>{matrix[(w, g)]}</td>" for g in order) + "</tr>"
        for w in order)
    matrix_html = ('<div class="tablewrap"><table class="cases matrix">'
                   '<caption>Expected vs actual exit code (3\u00d73)</caption>'
                   '<thead><tr><th scope="col">expected \\ actual</th>'
                   + "".join(f"<th scope=\"col\">{html.escape(gnames[g])}</th>" for g in order)
                   + "</tr></thead><tbody>" + mrows + "</tbody></table></div>")
    if nonstd:
        matrix_html += ('<p class="tiers">Non-standard verdicts (outside rc 1/2/0): '
                        + html.escape("; ".join(nonstd)) + ".</p>")
    fixture_note = (f'<p class="tiers">The corpus is {adv["total"]} author-designed regression fixtures \u2014 '
                    'not a real-world sample. These pass rates measure fixture conformance, '
                    'not detector quality in the wild.</p>')
    cases_html = (tier_line + ci_line + fixture_note + matrix_html
                  + '<div class="tablewrap"><table class="cases"><caption>Per-case want vs got</caption><thead><tr>'
                  '<th scope="col">case</th><th scope="col">expected exit code</th><th scope="col">actual exit code</th>'
                  '<th scope="col">match</th></tr></thead><tbody>'
                  + "".join(rows) + "</tbody></table></div>")
render_card(fsuite, extra=cases_html)

modebar = {
    "SIMULATED": ('sim', '<strong>SIMULATED</strong> \u2014 fake binaries; nothing was sent.'),
    "LIVE-FIRE": ('live', '<strong>LIVE-FIRE</strong> \u2014 real sends to the owner\u2019s own accounts; synthetic payloads only.'),
    "UNKNOWN": ('unknown', '<strong>MODE UNKNOWN</strong> \u2014 the mode could not be determined from the audit output; treat this report as unreliable.'),
}[mode]
stubbar = ""
if stub:
    stub_score = f"{adv['matched']}/{adv['total']}" if adv else "the corpus score"
    stubbar = (f'<div class="modebar stub"><strong>SYNTHETIC STUB TARGET</strong> \u2014 harness self-test '
               'against the bundled test double; not a validation of any real installation. '
               f'A {stub_score} here proves harness self-consistency, not detector quality.</div>')

findings_html = ""
if findings:
    rows = "".join(
        f'<li><strong>{html.escape(t)}</strong> '
        f'<a class="flink" href="#card-{html.escape(l)}">evidence \u2192</a>'
        + (f'<br><span class="fev">{html.escape(e)}</span>' if e else "") + "</li>"
        for t, e, l in findings)
    findings_html = f"""
<section class="findings" aria-labelledby="findings-h">
  <h2 id="findings-h">Findings ({len(findings)})</h2>
  <ul>{rows}</ul>
</section>"""

# Tri-state verdict legend: green = well protected (block-tier), yellow =
# protected through approval (review-tier), red = can leak. Purple marks
# stub self-consistency (never a protection claim); white marks tracked
# residuals (never silent, never a protection claim either).
legend_html = """
<section class="legend" aria-label="Verdict legend">
  <span><span aria-hidden="true">\U0001F7E2</span> <strong>well protected</strong> \u2014 block-tier: refused outright (rc=1)</span>
  <span><span aria-hidden="true">\U0001F7E1</span> <strong>protected through approval</strong> \u2014 review-tier: refused without explicit approval (rc=2)</span>
  <span><span aria-hidden="true">\U0001F534</span> <strong>can leak</strong> \u2014 a check failed, or something that should have been stopped was not</span>
  <span><span aria-hidden="true">\U0001F7E3</span> <strong>stub self-consistency</strong> \u2014 harness check against the synthetic test double, not a protection claim</span>
  <span><span aria-hidden="true">\u26AA</span> <strong>tracked residual</strong> \u2014 known gap, reported openly, never silent</span>
</section>"""

transcript_html = f"""
<section class="transcript" aria-labelledby="transcript-h">
  <h2 id="transcript-h">Raw transcripts</h2>
  <details><summary>bin/leakage-audit</summary><pre>{html.escape(scrub_transcript(text))}</pre></details>
  <details><summary>bin/adversarial-run</summary><pre>{html.escape(scrub_transcript(adv_text))}</pre></details>
</section>"""

# CI provenance (present only when generated inside GitHub Actions)
ci_span = ""
gh_run = os.environ.get("GITHUB_RUN_ID", "")
if gh_run:
    gh_server = os.environ.get("GITHUB_SERVER_URL", "https://github.com")
    gh_repo = os.environ.get("GITHUB_REPOSITORY", "")
    gh_sha = os.environ.get("GITHUB_SHA", "")[:7]
    gh_url = f"{gh_server}/{gh_repo}/actions/runs/{gh_run}"
    ci_span = (f'<span>CI run: <a href="{html.escape(gh_url, quote=True)}">'
               f'{html.escape(gh_repo)} #{html.escape(gh_run)}</a> ({html.escape(gh_sha)})</span>')
stub_span = '<span><strong>target-kind: SYNTHETIC STUB</strong></span>' if stub else ""
footer_text = ("Synthetic stub target \u2014 this report validates the harness against the bundled test double, "
               "not any real installation. Synthetic payloads only \u2014 nothing real was sent or disclosed."
               if stub else
               ("Real sends to the owner's own accounts \u2014 synthetic payloads only." if mode == "LIVE-FIRE"
                else "Synthetic payloads only \u2014 nothing real was sent or disclosed."))

page = f"""<!DOCTYPE html>
