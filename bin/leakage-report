<script>
// Auto-expand failing cards: red means "can leak" — the reader should see
// the evidence without an extra tap. Findings link back to these cards.
document.querySelectorAll('.card.red').forEach(function(card){{
  var detail = card.querySelector('.detail');
  var head = card.querySelector('.card-head');
  if (detail && detail.hasAttribute('hidden')) {{
    detail.removeAttribute('hidden');
    card.classList.add('open');
    head.setAttribute('aria-expanded', 'true');
  }}
}});
document.querySelectorAll('.card-head').forEach(function(head){{
  head.addEventListener('click', function(){{
    var card = head.closest('.card');
    var detail = card.querySelector('.detail');
    var open = detail.hasAttribute('hidden');
    if (open) {{ detail.removeAttribute('hidden'); }}
    else {{ detail.setAttribute('hidden', ''); }}
    card.classList.toggle('open', open);
    head.setAttribute('aria-expanded', open ? 'true' : 'false');
  }});
}});
</script>
