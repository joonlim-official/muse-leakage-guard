#!/usr/bin/env bash
# leakage-audit: validate a private-memory leakage protection installation.
#
# Checks installation integrity, red-teams every gate and send path with
# synthetic payloads, statically verifies coverage of the attack surface,
# and reviews the gate audit log. By default nothing is ever really sent:
# send-path tests run against fake "real" binaries via MOCHI_REAL_* overrides.
# Opt-in live-fire mode (MOCHI_LIVE_FIRE=1) exercises the genuine end-to-end
# path instead: real sends to the owner's own accounts, synthetic payloads
# only. The report always labels which mode ran (SIMULATED vs LIVE-FIRE).
#
# Configuration (env wins; $SKILL_DIR/local.env inside the skill dir is sourced
# if present and only fills variables not already set in the environment.
# local.env is gitignored — keep installation-specific values there.
# Precedence: explicit environment > local.env > built-in default):
#   PERSONAL_MEMORY_SKILL   memory skill under test (default ~/workspace/skills/personal-memory-system)
#   PERSONAL_MEMORY_ROOT    memory root passed through to the gates (default ~)
#   MOCHI_AGENTS_FILE       agent operating manual (default ~/AGENTS.md)
#   MOCHI_CRON_PROMPT_DIRS  colon-separated dirs of scheduled-job prompts (default: empty = skip)
#   MOCHI_EGRESS_LOG        gate audit log (default ~/workspace/memory-sync/egress-gate.log)
#   MOCHI_MEMORY_AUDIT=1    also run the memory skill's own memory-audit
#   MOCHI_LIVE_FIRE=1       opt-in: suite B sends for real to the owner's own
#                           accounts (default: simulated via fake binaries).
#                           Must be set inline in the invoking environment;
#                           a value from local.env alone is ignored. Never export.
#   MOCHI_LIVE_FIRE_NONINTERACTIVE=1  allow live-fire without a TTY (default:
#                           refused when stdin is not a TTY or $CI is set).
#   MOCHI_TEST_EMAIL        live-fire email recipient (no default — required).
#                           Must be the owner's own address; verified against
#                           the Gmail profile before any send. Never anyone else's.
#   MOCHI_TEST_MESSENGER_CID  live-fire Messenger target conversation id.
#                           Must resolve to the owner's own chat (default:
#                           auto-discovered); anything else fails closed.
#
# Usage: bin/leakage-audit [-h|--help]
# Exit 0 = all checks pass (skips don't fail). Exit 1 = at least one FAIL.
# Exit 2 = usage error or refused live-fire (environment, not findings).
set -u

case "${1:-}" in
  -h|--help) sed -n '2,/^#$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
esac
if [ $# -gt 0 ]; then echo "leakage-audit: unknown option: $1 (usage: bin/leakage-audit [-h|--help])" >&2; exit 2; fi

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Snapshot explicit environment so local.env can only supply defaults,
# never override the operator's invocation (and never arm live-fire).
_LIVE_FIRE_ENV="${MOCHI_LIVE_FIRE:-}"
_saved_vars=()
for _v in PERSONAL_MEMORY_SKILL PERSONAL_MEMORY_ROOT MOCHI_AGENTS_FILE \
  MOCHI_CRON_PROMPT_DIRS MOCHI_EGRESS_LOG MOCHI_MEMORY_AUDIT MOCHI_LIVE_FIRE \
  MOCHI_LIVE_FIRE_NONINTERACTIVE MOCHI_TEST_EMAIL MOCHI_TEST_MESSENGER_CID; do
  if [ -n "${!_v+x}" ]; then _saved_vars+=("$_v=${!_v}"); fi
done
[ -f "$SKILL_DIR/local.env" ] && . "$SKILL_DIR/local.env"
if [ "${#_saved_vars[@]}" -gt 0 ]; then
  for _kv in "${_saved_vars[@]}"; do export "$_kv"; done
fi
unset _v _kv _saved_vars

MEM_SKILL="${PERSONAL_MEMORY_SKILL:-$HOME/workspace/skills/personal-memory-system}"
# Target kind: a synthetic stub (test/stub-memory-skill/.synthetic-stub)
# is a harness self-consistency double, not the owner's installation.
# It is labelled as such in the header, the machine sentinels, and the
# HTML report — and live-fire is refused against it (see below).
STUBKIND=""
if [ -f "$MEM_SKILL/.synthetic-stub" ]; then STUBKIND="synthetic-stub"; fi
# Contract version this audit implements (references/gate-interface.md,
# `contract_version`). A target declaring a different version is not
# conformance-checked: the checks below are contract-shaped, so version
# skew would be misattributed as broken gates.
AUDIT_INTERFACE_VERSION="1"
INTERFACE_OK=1
# Portable canonicalizer for identity comparisons (symlinked/aliased
# spellings must not defeat "is this the same file" assertions).
canon_path() {
  if command -v realpath >/dev/null 2>&1; then realpath -m "$1" 2>/dev/null || printf '%s\n' "$1"
  elif readlink -f "$1" >/dev/null 2>&1; then readlink -f "$1"
  else printf '%s\n' "$1"; fi
}
export PERSONAL_MEMORY_ROOT="${PERSONAL_MEMORY_ROOT:-$HOME}"
AGENTS_FILE="${MOCHI_AGENTS_FILE:-$HOME/AGENTS.md}"
CRON_DIRS="${MOCHI_CRON_PROMPT_DIRS:-}"
GATE_LOG="${MOCHI_EGRESS_LOG:-$HOME/workspace/memory-sync/egress-gate.log}"
REAL_LOG="$GATE_LOG"   # the configured log; validation below uses a temp one
FIX="$SKILL_DIR/bin/fixtures"
SHIMDIR="$MEM_SKILL/bin/shims"

# Validation mode, labelled in the header, the summary, and the HTML report
# so a reader never mistakes a simulated run for a live-fire one.
# Live-fire is strictly per-invocation opt-in: it must be set inline in the
# invoking environment. A MOCHI_LIVE_FIRE=1 that came only from local.env
# is ignored with a loud warning — a stale file must never arm real sends.
if [ "${_LIVE_FIRE_ENV:-}" != "1" ] && [ "${MOCHI_LIVE_FIRE:-}" = "1" ]; then
  echo "leakage-audit: WARNING: MOCHI_LIVE_FIRE=1 came from local.env, not the invoking environment;" >&2
  echo "leakage-audit: WARNING: ignoring it. Set MOCHI_LIVE_FIRE=1 inline to opt in per run." >&2
  MOCHI_LIVE_FIRE=""
fi
unset _LIVE_FIRE_ENV
if [ "${MOCHI_LIVE_FIRE:-}" = "1" ]; then
  if [ "$STUBKIND" = "synthetic-stub" ]; then
    echo "leakage-audit: refusing live-fire against a synthetic stub target ($MEM_SKILL)." >&2
    echo "leakage-audit: live-fire exercises the real end-to-end path; point PERSONAL_MEMORY_SKILL at the real installation." >&2
    exit 2
  fi
  if { [ -n "${CI:-}" ] || [ ! -t 0 ]; } && [ "${MOCHI_LIVE_FIRE_NONINTERACTIVE:-}" != "1" ]; then
    echo "leakage-audit: refusing live-fire in a non-interactive context (stdin is not a TTY or \$CI is set)." >&2
    echo "leakage-audit: set MOCHI_LIVE_FIRE_NONINTERACTIVE=1 to override explicitly." >&2
    exit 2
  fi
  AUDIT_MODE="LIVE-FIRE (real sends to owner's own accounts; synthetic payloads only)"
  AUDIT_MODE_SHORT="LIVE-FIRE"
else
  AUDIT_MODE="SIMULATED (fake binaries; nothing is sent)"
  AUDIT_MODE_SHORT="SIMULATED"
fi

PASS=0; FAIL=0; SKIPPED=0; WARN=0
SUITE_LETTER=""; SUITE_NAME=""; sP=0; sF=0; sS=0
ROWS=""; FINDINGS=""

# Report width: override with MOCHI_REPORT_WIDTH, else terminal width,
# else a mobile-friendly 48. Clamped to [40, 76].
WIDTH="${MOCHI_REPORT_WIDTH:-}"
if [ -z "$WIDTH" ]; then WIDTH="$(tput cols 2>/dev/null || echo 48)"; fi
case "$WIDTH" in ''|*[!0-9]*) WIDTH=48;; esac
[ "$WIDTH" -lt 40 ] && WIDTH=40
[ "$WIDTH" -gt 76 ] && WIDTH=76
RULE="$(printf '─%.0s' $(seq 1 $((WIDTH-2))))"
BOLD_RULE="$(printf '═%.0s' $(seq 1 $((WIDTH-2))))"

shorten() { printf '%s' "${1//$HOME/\~}"; }   # $HOME -> ~ for display

# Machine-readable sentinels for bin/leakage-report: structural lines the
# evidence path cannot accidentally produce (a hostile check name or wrapped
# CLI output can never forge them). Emitted only when MOCHI_AUDIT_MACHINE=1 —
# leakage-report sets it; terminal output is unchanged.
msent() {
  [ "${MOCHI_AUDIT_MACHINE:-}" = "1" ] || return 0
  local p="$*"
  p="${p//$'\n'/ }"; p="${p//@@@/[at]}"
  printf '@@@ %s\n' "$p"
}

# Wrapped check line: "  ✓ text", continuations indented.
wcheck() {
  printf '%s\n' "$*" | fold -s -w "$((WIDTH-4))" | sed 's/ *$//' | sed '1s/^/  /; 2,$s/^/    /'
}
# Wrapped detail line: word-aware wrap (screen-reader friendly); overlong
# tokens are still broken so evidence never scrolls sideways.
# Reads stdin or args; each logical line wraps independently.
wdetail() {
  { if [ $# -gt 0 ]; then printf '%s\n' "$*"; else cat; fi; } \
    | while IFS= read -r line; do
        msent "CTX $line"
        printf '%s\n' "$line" | fold -s -w "$((WIDTH-6))" | sed 's/ *$//' | sed '1s/^/    /; 2,$s/^/      /'
      done
}

ok()   { PASS=$((PASS+1)); msent "CHECK PASS $(shorten "$1")"; wcheck "✓ $(shorten "$1")"; }
# warn <name> [detail] — a finding worth surfacing that does not fail the
# audit (e.g. an empty gate log: honest, but the "gate is exercised" claim
# cannot be made). Counted separately; never silent, never red.
warn() { WARN=$((WARN+1)); msent "CHECK WARN $(shorten "$1")"; wcheck "⚠ $(shorten "$1")";
         if [ -n "${2:-}" ]; then printf '%s\n' "$2" | wdetail; fi }
# bad <name> [evidence] [suggestion] — every failure carries a concrete
# suggested remediation. This skill validates and suggests; it never
# applies fixes — remediation belongs to the memory skill / the agent.
bad()  { FAIL=$((FAIL+1))
         _blabel="$1"; [ -n "$SUITE_LETTER" ] && _blabel="[$SUITE_LETTER] $1"
         msent "CHECK FAIL $(shorten "$_blabel")"
         wcheck "✗ $(shorten "$_blabel")"
         FINDINGS="${FINDINGS}$(wcheck "✗ $(shorten "$_blabel")")"$'\n'
         if [ -n "${2:-}" ]; then
           printf '%s\n' "$2" | wdetail
           FINDINGS="${FINDINGS}$(printf '%s\n' "$2" | wdetail)"$'\n'
         fi
         if [ -n "${3:-}" ]; then
           printf '%s\n' "Suggestion: $3" | wdetail
           FINDINGS="${FINDINGS}$(printf '%s\n' "Suggestion: $3" | wdetail)"$'\n'
         fi
         unset _blabel; }
skip() { SKIPPED=$((SKIPPED+1)); msent "CHECK SKIP $(shorten "$1") [$(shorten "$2")]"; wcheck "– $(shorten "$1") [$(shorten "$2")]"; }

begin_suite() { # <letter> <name>
  SUITE_LETTER="$1"; SUITE_NAME="$2"; sP=$PASS; sF=$FAIL; sS=$SKIPPED
  msent "SUITE $1 $2"
  printf '\n'
  printf '  %s. %s\n' "$1" "$2" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/     /'
  printf '  %s\n' "$RULE"
}
end_suite() {
  local p=$((PASS-sP)) f=$((FAIL-sF)) s=$((SKIPPED-sS)) label
  label="${SUITE_NAME%% (*}"   # suite name without parenthetical subtitle
  msent "ENDSUITE $SUITE_LETTER $p $f $s"
  printf '  %s\n' "$RULE"
  printf '    %d passed · %d failed · %d skipped\n' "$p" "$f" "$s"
  ROWS="${ROWS}${SUITE_LETTER}|${label}|${p}|${f}|${s}"$'\n'
}

print_header() {
  printf '\n  muse-leakage-guard · leakage-audit\n'
  printf '  %s\n' "$(date '+%Y-%m-%d %H:%M %Z')"
  msent "TS $(date '+%Y-%m-%d %H:%M %Z')"
  printf '%s\n' "target: $(shorten "$MEM_SKILL")" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "TARGET $(shorten "$MEM_SKILL")"
  if [ "$STUBKIND" = "synthetic-stub" ]; then
    printf '%s\n' "target-kind: SYNTHETIC STUB — interface-conformance double, not the owner's installation" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
    msent "STUBKIND synthetic-stub"
  fi
  printf '%s\n' "mode: $AUDIT_MODE" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "MODE $AUDIT_MODE_SHORT"
  printf '  %s\n' "$BOLD_RULE"
}

print_summary() {
  printf '\n  Summary\n'
  printf '  %s\n' "$RULE"
  if [ "$WIDTH" -ge 56 ]; then
    printf '  %-32s %5s %5s %5s\n' "Suite" "Pass" "Fail" "Skip"
    printf '  %s\n' "$RULE"
    while IFS='|' read -r l lab p f s; do
      [ -n "$l" ] || continue
      printf '  %-32s %5d %5d %5d\n' "$l. $lab" "$p" "$f" "$s"
    done <<< "$ROWS"
    printf '  %s\n' "$RULE"
    printf '  %-32s %5d %5d %5d\n' "Total" "$PASS" "$FAIL" "$SKIPPED"
    if [ "$WARN" -gt 0 ]; then printf '  %-32s %5d\n' "Warnings" "$WARN"; fi
  else
    while IFS='|' read -r l lab p f s; do
      [ -n "$l" ] || continue
      printf '  %s. %s\n' "$l" "$lab"
      printf '    %d passed · %d failed · %d skipped\n' "$p" "$f" "$s"
    done <<< "$ROWS"
    printf '  %s\n' "$RULE"
    printf '%s\n' "Total: $PASS passed · $FAIL failed · $SKIPPED skipped" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
    if [ "$WARN" -gt 0 ]; then printf '%s\n' "Warnings: $WARN" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'; fi
  fi
  if [ "$FAIL" -eq 0 ]; then
    if [ "$WARN" -gt 0 ]; then
      v="VERDICT: CLEAN — all $PASS checks passed ($SKIPPED skipped, $WARN warning(s) noted above)."
    elif [ "$SKIPPED" -gt 0 ]; then
      v="VERDICT: CLEAN — all $PASS checks passed ($SKIPPED skipped)."
    else
      v="VERDICT: CLEAN — all $PASS checks passed."
    fi
  else
    v="VERDICT: ATTENTION — $FAIL finding(s) need review."
  fi
  printf '%s\n' "mode: $AUDIT_MODE" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "TOTAL $PASS $FAIL $SKIPPED"
  msent "WARNINGS $WARN"
  printf '%s\n' "$v" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "VERDICT $v"
  if [ "$FAIL" -gt 0 ]; then
    printf '\n  Findings\n'
    printf '  %s\n' "$RULE"
    printf '%s\n' "$FINDINGS"
  fi
  printf '\n'
}

print_header

T="$(mktemp -d)"

# ---------------------------------------------------------------- A. install
begin_suite "A" "Installation integrity"
# Keep validation out of the real gate log from the very first gate
# invocation: every check below writes to a throwaway log instead.
export MOCHI_EGRESS_LOG="$T/gate.log"
# Contract conformance is established before any contract-shaped probe runs:
# the target must declare the interface version this audit implements.
if [ "$STUBKIND" = "synthetic-stub" ]; then
  declared_ver="$(grep -E '^interface_version=' "$MEM_SKILL/.synthetic-stub" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')"
  if [ "$declared_ver" = "$AUDIT_INTERFACE_VERSION" ]; then
    ok "target declares interface_version=$declared_ver (matches audit contract version $AUDIT_INTERFACE_VERSION)"
  else
    bad "interface version mismatch: target declares '${declared_ver:-unparsable}', audit implements $AUDIT_INTERFACE_VERSION" "" "contract checks are not meaningful across versions; update the harness or the target so both speak interface version $AUDIT_INTERFACE_VERSION, then re-run."
    INTERFACE_OK=0
  fi
else
  skip "interface_version check" "real target declares no interface_version (the contract names no declaration point for real skills yet — see references/gate-interface.md)"
fi
for f in bin/egress-gate bin/brief-gate bin/memory-egress-check bin/memory-guard; do
  if [ -x "$MEM_SKILL/$f" ]; then ok "$f present and executable"
  else bad "$f missing or not executable" "" "restore it from the muse-memory repo and chmod +x, then re-run this audit."; fi
done
for f in bin/egress-gate bin/brief-gate bin/memory-egress-check bin/memory-guard bin/shims/hatch_gws_cli bin/shims/hatch_messenger_cli; do
  if bash -n "$MEM_SKILL/$f" 2>/dev/null; then ok "$f parses"
  else bad "$f has syntax errors" "" "run: bash -n $MEM_SKILL/$f to locate the error, fix it, then re-run this audit."; fi
done
for cli in hatch_gws_cli hatch_messenger_cli; do
  if [ ! -x "$SHIMDIR/$cli" ]; then bad "shim $cli missing" "" "restore bin/shims/$cli from the muse-memory repo; every agent context must put the shims dir first on PATH."; continue; fi
  resolved="$(PATH="$SHIMDIR:$PATH" command -v "$cli")"
  if [ "$resolved" = "$SHIMDIR/$cli" ]; then ok "shim $cli shadows real binary on PATH"
  else bad "shim $cli does NOT shadow (resolves to $resolved)" "" "fix PATH ordering: export PATH=\"<memory-skill>/bin/shims:\$PATH\" before any other entry providing $cli."; fi
  shim_canon="$(canon_path "$SHIMDIR/$cli")"
  real_found=0; real_self=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    [ "$(canon_path "$d")" = "$(canon_path "$SHIMDIR")" ] && continue
    if [ -x "$d/$cli" ]; then
      # Canonical identity: a symlinked/aliased spelling of the shim's own
      # dir must not pass as "a distinct delegate" (it would self-exec).
      if [ "$(canon_path "$d/$cli")" = "$shim_canon" ]; then real_self=1; else real_found=1; fi
      break
    fi
  done <<< "${PATH//:/$'\n'}"
  if [ "$real_self" -eq 1 ]; then bad "delegate $cli resolves to the shim itself (self-exec loop)" "" "unset the MOCHI_REAL_* override or fix PATH so the shim delegates to a distinct binary; a self-delegate exec-loops."
  elif [ "$real_found" -eq 1 ]; then ok "real $cli discoverable behind shim (distinct executable)"
  else bad "real $cli not found on PATH — shim has nothing to delegate to" "" "install the real CLI or extend PATH so the shim has a delegate; a shim with no delegate breaks every send."; fi
done

# Fixture integrity: a missing or empty fixture makes its check vacuous
# (an empty "clean" fixture passes trivially; a missing block-tier fixture
# can error into a misleading verdict). Fail closed on fixture rot.
for fix in clean.txt secret.txt secret2.txt ssn.txt card.txt figure.txt phone.txt; do
  if [ ! -f "$FIX/$fix" ]; then bad "fixture $fix missing" "" "restore bin/fixtures/$fix from the repo, then re-run this audit."
  elif [ ! -s "$FIX/$fix" ]; then bad "fixture $fix is empty (vacuous test)" "" "restore the fixture content from the repo, then re-run this audit."
  else ok "fixture $fix present and non-empty"; fi
done
corpus_cases="$(grep -vcE '^[[:space:]]*(#|$)' "$SKILL_DIR/bin/adversarial-corpus.txt" 2>/dev/null || true)"
if [ "$corpus_cases" -ge 1 ]; then ok "adversarial corpus has $corpus_cases cases"
else bad "adversarial corpus is empty — 0/0 would be a vacuous pass" "" "restore bin/adversarial-corpus.txt from the repo, then re-run this audit."; fi

if [ "$STUBKIND" = "synthetic-stub" ]; then
  # Operational failure must fail closed, never become approvable: a stub
  # copy with no blockset.txt, gated with approval set, must still refuse.
  broken_stub="$T/broken-stub"
  cp -r "$MEM_SKILL" "$broken_stub"
  rm -f "$broken_stub/bin/blockset.txt"
  op_rc=0
  MOCHI_EGRESS_APPROVED=1 "$broken_stub/bin/egress-gate" --content-file "$FIX/clean.txt" --context "leakage-audit:operational-failure" >/dev/null 2>&1 || op_rc=$?
  rm -rf "$broken_stub"
  if [ "$op_rc" -eq 1 ]; then ok "operational failure (missing blockset) fails closed under approval (rc=1)"
  else bad "operational failure (missing blockset) with approval returned rc=$op_rc (want 1)" "" "a broken detector must never be approval-downgraded to allow; fix the gate's error paths, then re-run."; fi
  # The stub's blockset must be current: a locally-stale blockset.txt fails
  # loudly as verdict mismatches, but suite A is the natural home for
  # "is the target self-consistent".
  if "$MEM_SKILL/build/build-blockset.sh" --check >/dev/null 2>&1; then ok "stub blockset.txt is current (build-blockset.sh --check)"
  else bad "stub blockset.txt is stale" "" "run: test/stub-memory-skill/build/build-blockset.sh, then re-run this audit."; fi
else
  skip "operational-failure approval isolation" "stub-only: exercises the synthetic stub's fail-closed error paths"
  skip "blockset currency" "stub-only: the real installation has no build-blockset.sh"
fi

# Fail-closed on abnormal detector exits: a detector that crashes (rc=3) or
# is killed (rc=137) must read as BLOCKED, never as clean. Exercised on a
# /tmp copy of the target so the real files are untouched; runs for every
# target (stub and real).
crash_stub="$T/crash-target"
for crash_rc in 3 137; do
  rm -rf "$crash_stub"; cp -r "$MEM_SKILL" "$crash_stub"
  printf '#!/usr/bin/env bash\nexit %s\n' "$crash_rc" > "$crash_stub/bin/memory-egress-check"
  chmod +x "$crash_stub/bin/memory-egress-check"
  for gate in egress-gate brief-gate; do
    if [ "$gate" = "brief-gate" ]; then
      timeout -k 10 30 "$crash_stub/bin/$gate" --brief-file "$FIX/clean.txt" --task "leakage-audit:crash-probe" >/dev/null 2>&1; grc=$?
    else
      timeout -k 10 30 "$crash_stub/bin/$gate" --content-file "$FIX/clean.txt" --context "leakage-audit:crash-probe" >/dev/null 2>&1; grc=$?
    fi
    if [ "$grc" -eq 1 ]; then ok "$gate fails closed on detector rc=$crash_rc (clean fixture refused)"
    else bad "$gate allowed clean content when the detector exited rc=$crash_rc (got rc=$grc, want 1)" "" "a broken detector must fail closed: any detector exit outside {0,1,2} must become BLOCKED (rc=1), never allow. Fix the gate's exit-code handling, then re-run."; fi
  done
done
rm -rf "$crash_stub"

end_suite

if [ "$INTERFACE_OK" != "1" ]; then
  # Contract version skew: every check below is contract-shaped, so running
  # them would misattribute version skew as broken gates. One clean verdict:
  # the single suite-A FAIL above, ATTENTION, exit 1.
  rm -rf "$T"
  print_summary
  exit 1
fi

# ------------------------------------------------- B. red team (fake sends)
if [ "$AUDIT_MODE_SHORT" = "LIVE-FIRE" ]; then
  begin_suite "B" "Gate effectiveness (red team, LIVE-FIRE: real sends to own accounts)"
else
  begin_suite "B" "Gate effectiveness (red team, synthetic payloads)"
fi
LIVE_FIRE="${MOCHI_LIVE_FIRE:-}"
if [ "$LIVE_FIRE" = "1" ]; then
  # Live-fire: the shims delegate to the genuine CLIs (no MOCHI_REAL_* overrides),
  # exercising the true end-to-end path: shim -> gate -> real binary.
  # Real sends go to the owner's own accounts ONLY (see below); payloads stay
  # synthetic. Drive share tests stay simulated — a live run must never
  # grant real access to anyone.
  #
  # Integrity: a stale MOCHI_REAL_* override (e.g. from local.env) would make
  # a "live-fire" run exercise fake binaries while the report claims LIVE-FIRE.
  # Refuse that confusion — unset them loudly.
  for _rv in MOCHI_REAL_HATCH_GWS_CLI MOCHI_REAL_HATCH_MESSENGER_CLI; do
    if [ -n "${!_rv:-}" ]; then
      wdetail "LIVE-FIRE: unsetting stale $_rv (was: ${!_rv}) — live-fire must use the genuine CLIs."
      unset "$_rv"
    fi
  done
  unset _rv
  wdetail "LIVE-FIRE: real sends to the owner's own accounts; synthetic payloads only."
else
  mkdir -p "$T/fakebin"
  # Draft bodies for the drafts-send probes: base64 MIME bodies the shim
  # decodes and gates. FAKE_DRAFT_BODY=secret|clean selects the variant.
  FAKE_DRAFT_SECRET_B64="$(python3 -c "import base64,sys; sys.stdout.write(base64.urlsafe_b64encode(open('$FIX/secret.txt','rb').read()).decode())")"
  FAKE_DRAFT_CLEAN_B64="$(python3 -c "import base64,sys; sys.stdout.write(base64.urlsafe_b64encode(open('$FIX/clean.txt','rb').read()).decode())")"
  export FAKE_DRAFT_SECRET_B64 FAKE_DRAFT_CLEAN_B64
  cat > "$T/fakebin/real-gws" <<'EOF'
#!/usr/bin/env bash
# Invocation sentinel: the audit asserts on this file, not on stdout text
# (a crashing binary could echo a marker without touching it). Arg values are
# hashed, never echoed — failure evidence must not carry fixture content.
if [ "${1:-} ${2:-} ${3:-}" = "users drafts get" ]; then
  # Read-only draft fetch for the drafts-send probes: a `drafts get` is not
  # a send, so it does not touch the invocation sentinel.
  if [ "${FAKE_DRAFT_BODY:-clean}" = "secret" ]; then
    printf '%s' "{\"message\":{\"payload\":{\"body\":{\"data\":\"$FAKE_DRAFT_SECRET_B64\"}}}"
  else
    printf '%s' "{\"message\":{\"payload\":{\"body\":{\"data\":\"$FAKE_DRAFT_CLEAN_B64\"}}}"
  fi
  exit 0
fi
touch "$T_INVOKED_DIR/invoked-any"
echo "REAL-GWS-INVOKED argv-sha256=$(printf '%s' "$*" | sha256sum | cut -d' ' -f1)"
exit 0
EOF
  cat > "$T/fakebin/real-msg" <<'EOF'
#!/usr/bin/env bash
touch "$T_INVOKED_DIR/invoked-any"
echo "REAL-MSG-INVOKED argv-sha256=$(printf '%s' "$*" | sha256sum | cut -d' ' -f1)"
echo "---stdin---"; cat; echo "---endstdin---"
exit 0
EOF
  chmod +x "$T/fakebin"/real-*
  export T_INVOKED_DIR="$T"
  export MOCHI_REAL_HATCH_GWS_CLI="$T/fakebin/real-gws"
  export MOCHI_REAL_HATCH_MESSENGER_CLI="$T/fakebin/real-msg"
fi
export MOCHI_EGRESS_LOG="$T/gate.log"   # (already set before suite A; restated for suite B's fake-binary section)
export PATH="$SHIMDIR:$PATH"

gate_expect() { # <name> <gate:egress|brief> <fixture> <want_rc>
  # timeout -k: a TERM-trapping gate is SIGKILLed after 10s, so the 30s
  # bound is enforced rather than advisory (rc=124 then engages the
  # fail-closed timeout path below).
  local name="$1" gate="$2" fix="$3" want="$4" rc
  if [ "$gate" = brief ]; then
    timeout -k 10 30 "$MEM_SKILL/bin/brief-gate" --brief-file "$FIX/$fix" --task "leakage-audit:$name" >/dev/null 2>&1; rc=$?
  else
    timeout -k 10 30 "$MEM_SKILL/bin/egress-gate" --content-file "$FIX/$fix" --context "leakage-audit:$name" >/dev/null 2>&1; rc=$?
  fi
  if [ "$rc" -eq 124 ]; then
    bad "$name" "gate timed out after 30s (did not refuse or pass in time)" \
      "investigate why the gate hung on fixture $fix; do not trust verdicts from this installation until it answers."
    return
  fi
  if [ "$rc" -eq "$want" ]; then ok "$name (rc=$rc)"
  else
    case "$want" in
      1) sug="block-tier payload passed the gate. Tighten SECRET_RE/BLOCK_RE in bin/memory-egress-check until fixture $fix matches, then re-run this audit.";;
      2) sug="review-tier content was not flagged. Check FIGURE_RE/PHONE_RE and the denylist in bin/memory-egress-check against fixture $fix, then re-run this audit.";;
      *) sug="benign content was gated (rc=$rc). Narrow the over-matching pattern — or, if the user ruled the literal public, add it to the installation's .egress-allowlist (review tier only; never for block-tier shapes).";;
    esac
    bad "$name" "want rc=$want, got rc=$rc" "$sug"
  fi
}
send_expect() { # <name> <want_rc> <want_invoked 0|1> -- cmd...
  local name="$1" want_rc="$2" want_inv="$3"; shift 3
  [ "${1:-}" = "--" ] && shift
  local out rc inv=0
  rm -f "$T/invoked-any"   # per-check sentinel; the fake real binary touches it
  out="$(timeout -k 10 30 "$@" 2>&1)"; rc=$?
  if [ "$rc" -eq 124 ]; then
    bad "$name" "send timed out after 30s (the shim or gate hung)" \
      "investigate the shim path for this subcommand; do not trust verdicts from this installation until sends answer."
    return
  fi
  [ -f "$T/invoked-any" ] && inv=1
  if [ "$rc" -eq "$want_rc" ] && [ "$inv" -eq "$want_inv" ]; then ok "$name (rc=$rc invoked=$inv)"
  else
    if [ "$want_inv" = "0" ] && [ "$inv" = "1" ]; then
      sug="a send that should have been stopped reached the real binary. Check that bin/shims routes this subcommand through bin/egress-gate."
    elif [ "$want_rc" = "0" ] && [ "$rc" -ne 0 ]; then
      sug="a clean send was stopped (rc=$rc). Check the gate patterns for over-matching, or the shim's subcommand routing."
    else
      sug="verdict or invocation mismatch. Reproduce with the fixture, then inspect the shim and gate path for this subcommand."
    fi
    bad "$name" "want rc=$want_rc invoked=$want_inv, got rc=$rc invoked=$inv :: $(printf '%s' "$out" | head -3 | tr '\n' '|')" "$sug"
  fi
}

for g in egress brief; do
  gate_expect "$g gate: clean passes"            "$g" clean.txt   0
  gate_expect "$g gate: fake api key blocked"   "$g" secret.txt  1
  gate_expect "$g gate: fake private key blocked" "$g" secret2.txt 1
  gate_expect "$g gate: test SSN blocked"       "$g" ssn.txt     1
  gate_expect "$g gate: test card blocked"      "$g" card.txt    1
  gate_expect "$g gate: figure needs approval"  "$g" figure.txt  2
  gate_expect "$g gate: phone needs approval"   "$g" phone.txt   2
done

G=hatch_gws_cli; M=hatch_messenger_cli

if [ "$LIVE_FIRE" != "1" ]; then
# --- simulated send path: fake "real" binaries; nothing is ever sent ---
send_expect "gmail +send clean passes" 0 1 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/clean.txt")"
send_expect "gmail +send secret blocked" 1 0 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/secret.txt")"
send_expect "gmail +reply ssn blocked" 1 0 -- $G gmail +reply --message-id x --body "$(cat "$FIX/ssn.txt")"
send_expect "gmail +send figure refused w/o approval" 2 0 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/figure.txt")"
send_expect "gmail +send figure allowed with approval" 0 1 -- env MOCHI_EGRESS_APPROVED=1 $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/figure.txt")"
# Approval isolation: block-tier verdicts are never downgraded by approval.
# A secret stays rc=1 even with MOCHI_EGRESS_APPROVED=1 — approval only
# overrides the review tier (rc=2). If either of these ever passes, the
# gate's tier separation is broken.
send_expect "gmail +send secret stays blocked with approval (approval isolation)" 1 0 -- env MOCHI_EGRESS_APPROVED=1 $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/secret.txt")"
send_expect "messenger send secret stays blocked with approval (approval isolation)" 1 0 -- env MOCHI_EGRESS_APPROVED=1 $M send --cid '999' --text-stdin < "$FIX/secret2.txt"
send_expect "gmail +send --draft with secret passes through (stays in account)" 0 1 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/secret.txt")" --draft
send_expect "gmail non-send passes through" 0 1 -- $G gmail +triage --max 1

RAW_MIME="$(python3 -c "import base64,sys; sys.stdout.write(base64.urlsafe_b64encode(open('$FIX/card.txt','rb').read()).decode())")"
send_expect "raw messages.send with card in MIME blocked" 1 0 -- $G gmail users messages send --params "{\"raw\":\"$RAW_MIME\"}"
# Contract stdin form: {"raw":"<base64url MIME>"} piped on stdin is gated
# exactly like the --params form — the MIME, not the envelope, is judged.
RAW_MIME_CLEAN="$(python3 -c "import base64,sys; sys.stdout.write(base64.urlsafe_b64encode(open('$FIX/clean.txt','rb').read()).decode())")"
printf '{"raw":"%s"}' "$RAW_MIME" > "$T/stdin-raw-card.json"
printf '{"raw":"%s"}' "$RAW_MIME_CLEAN" > "$T/stdin-raw-clean.json"
send_expect "raw messages.send via stdin with card in MIME blocked" 1 0 -- bash -c 'hatch_gws_cli gmail users messages send < "$1"' _ "$T/stdin-raw-card.json"
send_expect "raw messages.send via stdin with clean MIME passes" 0 1 -- bash -c 'hatch_gws_cli gmail users messages send < "$1"' _ "$T/stdin-raw-clean.json"
# Draft token-confusion: --draft as the VALUE of --subject is gated content,
# not a draft flag — it must not skip the gate on a secret body.
send_expect "gmail +send --subject --draft with secret blocked (draft token-confusion)" 1 0 -- $G gmail +send --to a@example.com --subject --draft --body "$(cat "$FIX/secret.txt")"
# reply-all is a send like any other: it must be gated, not pass through.
send_expect "gmail +reply-all secret blocked" 1 0 -- $G gmail +reply-all --to a@example.com --body "$(cat "$FIX/secret.txt")"
send_expect "gmail +reply-all clean passes" 0 1 -- $G gmail +reply-all --to a@example.com --body "$(cat "$FIX/clean.txt")"
# +forward is contract-covered: a regression in its shim routing must fail loudly.
send_expect "gmail +forward secret blocked" 1 0 -- $G gmail +forward --to a@example.com --body "$(cat "$FIX/secret.txt")"
send_expect "gmail +forward clean passes" 0 1 -- $G gmail +forward --to a@example.com --body "$(cat "$FIX/clean.txt")"
# "--" end-of-options must not let content dodge the parser: post-"--"
# positionals are gated as body.
send_expect "gmail +send --body -- secret blocked (-- parser bypass)" 1 0 -- $G gmail +send --to a@example.com --body -- "$(cat "$FIX/secret.txt")"
send_expect "gmail +send --body -- clean passes" 0 1 -- $G gmail +send --to a@example.com --body -- "$(cat "$FIX/clean.txt")"
# drafts send: draft creation is ungated by design, so the send step gates
# the draft's decoded body. A draft carrying a secret must be blocked.
send_expect "gmail drafts send with secret draft body blocked" 1 0 -- env FAKE_DRAFT_BODY=secret $G gmail users drafts send --params '{"id":"d1"}'
send_expect "gmail drafts send with clean draft body passes" 0 1 -- env FAKE_DRAFT_BODY=clean $G gmail users drafts send --params '{"id":"d1"}'
# settings-plane mutations redirect where mail goes: approval-gated.
send_expect "gmail settings updateAutoForwarding refused w/o approval" 2 0 -- $G gmail users settings updateAutoForwarding --params '{}'
send_expect "gmail settings updateAutoForwarding allowed with approval" 0 1 -- env MOCHI_EGRESS_APPROVED=1 $G gmail users settings updateAutoForwarding --params '{}'
send_expect "gmail settings get passes through (read-only)" 0 1 -- $G gmail users settings getAutoForwarding

send_expect "messenger send clean passes" 0 1 -- $M send --cid '999' --text-stdin < "$FIX/clean.txt"
send_expect "messenger send secret blocked" 1 0 -- $M send --cid '999' --text-stdin < "$FIX/secret2.txt"
send_expect "messenger edit secret blocked" 1 0 -- $M edit --cid '999' --text-stdin < "$FIX/secret2.txt"
send_expect "messenger edit clean passes" 0 1 -- $M edit --cid '999' --text-stdin < "$FIX/clean.txt"
send_expect "messenger send --text -- secret blocked (-- parser bypass)" 1 0 -- $M send --cid '999' --text -- "$(cat "$FIX/secret2.txt")" < /dev/null
send_expect "messenger threads passes through" 0 1 -- $M threads --limit 1 < /dev/null

send_expect "drive permissions create refused w/o approval" 2 0 -- $G drive permissions create --params '{}'
send_expect "drive permissions create allowed with approval" 0 1 -- env MOCHI_EGRESS_APPROVED=1 $G drive permissions create --params '{}'
# Positional subcommand match: the refusal must not fire on the same words
# in other positions (fail-closed false positive). Stub-only: pins the
# reference shim's precision; the real shim is conservatively broader
# (fail-closed), which the contract permits.
if [ "$STUBKIND" = "synthetic-stub" ]; then
  send_expect "drive files create --name permissions not refused (positional match)" 0 1 -- $G drive files create --name permissions
else
  skip "drive files create --name permissions positional match" "stub-only: the real shim is conservatively broader (fail-closed), which the contract permits"
fi
send_expect "drive files list passes through (free zone)" 0 1 -- $G drive files list

# stdin replay integrity: what the fake binary received must equal the fixture
out="$($M send --cid '999' --text-stdin < "$FIX/clean.txt" 2>/dev/null)"
replayed="$(printf '%s' "$out" | sed -n '/---stdin---/,/---endstdin---/p' | sed '1d;$d')"
if [ "$replayed" = "$(cat "$FIX/clean.txt")" ]; then ok "messenger stdin replayed byte-identical on allow"
else bad "messenger stdin replay mismatch" "" "the shim altered stdin when replaying to the real binary. Inspect the shim's stdin handling before it reaches the delegate."; fi
# Gate-decision logging is a contract requirement (gate-interface.md):
# after this suite's blocked sends, the temp gate log must exist and carry
# BLOCKED verdicts. A gate that stopped logging would otherwise go unnoticed.
if [ -f "$T/gate.log" ] && grep -q "BLOCKED" "$T/gate.log" 2>/dev/null; then
  ok "gate decisions logged during red-team (contract)"
else bad "gate log has no BLOCKED decisions after red-team sends" "" "the contract requires every gate decision to be logged to \$MOCHI_EGRESS_LOG. Check that bin/egress-gate appends its verdict line on every invocation."; fi
else
# --- live-fire: small representative subset, real sends to the owner's own accounts ---
# Payloads are the same synthetic fixtures; only the transport is real.
live_send_expect() { # <name> <want_rc> -- cmd...
  # timeout -k, same as the simulated path: a hung real CLI fails closed
  # (rc=124 -> finding) instead of wedging the audit mid-suite.
  local name="$1" want="$2"; shift 2
  [ "${1:-}" = "--" ] && shift
  local out rc
  out="$(timeout -k 10 30 "$@" 2>&1)"; rc=$?
  if [ "$rc" -eq 124 ]; then
    bad "$name" "live send timed out after 30s (did not refuse or pass in time)" \
      "a wedged real binary fails the audit instead of hanging it. Investigate the CLI before re-running with MOCHI_LIVE_FIRE=1."
    return
  fi
  if [ "$rc" -eq "$want" ]; then ok "$name (rc=$rc)"
  else bad "$name" "want rc=$want, got rc=$rc :: $(printf '%s' "$out" | head -3 | tr '\n' '|')" \
    "a live-fire send behaved unexpectedly. Inspect the shim and gate path for this subcommand before re-running with MOCHI_LIVE_FIRE=1."
  fi
}

LIVE_EMAIL="${MOCHI_TEST_EMAIL:-}"
if [ -z "$LIVE_EMAIL" ]; then
  bad "live-fire: no test email configured" "" "set MOCHI_TEST_EMAIL to the owner's own address (never anyone else's). There is no default."
else
  # Verify the target belongs to the owner: the Gmail profile's address must
  # match, case-insensitively. Fail closed on mismatch or when the identity
  # cannot be determined — never trust the address blindly. (Read-only call;
  # the shim passes non-send subcommands straight through to the real CLI.)
  _profile_addr="$("$G" gmail users getProfile --params '{"userId":"me"}' --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("emailAddress",""))' 2>/dev/null)"
  if [ -z "$_profile_addr" ]; then
    bad "live-fire: cannot determine Gmail identity" "" "the getProfile check failed; refusing to send without verifying the target belongs to the owner."
  elif [ "${_profile_addr,,}" != "${LIVE_EMAIL,,}" ]; then
    bad "live-fire: target is not the owner's address" "MOCHI_TEST_EMAIL domain=${LIVE_EMAIL##*@} vs Gmail identity domain=${_profile_addr##*@} (full addresses redacted)" "set MOCHI_TEST_EMAIL to the owner's own address (never anyone else's)."
  else
    wdetail "live-fire target: $LIVE_EMAIL (verified against the Gmail profile)"
    MARK="leakage-audit live-fire $(date +%Y%m%d-%H%M%S)-$$"
    if [ -t 0 ]; then
      wdetail "Sending 3 test emails to the owner's own address ($LIVE_EMAIL). Ctrl-C now to abort."
      sleep 10
    fi
    # Block-tier: the gate must refuse (rc=1), so the shim never invokes the real
    # binary. If a block-tier test ever arrives in the inbox, that is a real
    # finding — report it, do not re-run.
    live_send_expect "gmail live-fire: secret blocked, nothing sent" 1 -- $G gmail +send --to "$LIVE_EMAIL" --subject "[$MARK] block-tier test (synthetic)" --body "$(cat "$FIX/secret.txt")"
    live_send_expect "gmail live-fire: clean delivered end-to-end" 0 -- $G gmail +send --to "$LIVE_EMAIL" --subject "[$MARK] clean test (synthetic)" --body "$(cat "$FIX/clean.txt")"
    live_send_expect "gmail live-fire: figure delivered with explicit approval" 0 -- env MOCHI_EGRESS_APPROVED=1 $G gmail +send --to "$LIVE_EMAIL" --subject "[$MARK] approval-tier test (synthetic)" --body "$(cat "$FIX/figure.txt")"
  fi
  unset _profile_addr
fi

# Resolve the owner's own Messenger chat: a thread whose participants are all
# the owner. An explicit MOCHI_TEST_MESSENGER_CID must resolve to such a chat
# or the run fails closed — live-fire never sends to anyone but the owner.
SELF_CID=""
if SELF_CID="$("$M" threads --limit 50 2>/dev/null | python3 -c '
import json,sys
self_id=None; cids={}
for line in sys.stdin:
    s=line.strip()
    if not s.startswith("{"): continue
    try: d=json.loads(s)
    except Exception: continue
    data=d.get("data")
    if not isinstance(data,dict): continue
    sid=(data.get("_cache") or {}).get("self_user_id")
    if sid: self_id=str(sid)
    for t in data.get("threads") or []:
        parts=[str(p.get("id")) for p in (t.get("participants") or [])]
        cids[str(t.get("conversation_id"))]=parts
if not self_id: sys.exit(0)
wanted=sys.argv[1] if len(sys.argv)>1 else ""
def self_only(parts):
    # Exactly one participant and it is the owner. Group threads (even ones
    # whose participant list renders incompletely) can never satisfy this.
    return len(parts)==1 and parts[0]==self_id
if wanted:
    parts=cids.get(wanted)
    if parts and self_only(parts): print(wanted)
    else: sys.exit(2)
else:
    for cid,parts in cids.items():
        if parts and self_only(parts): print(cid); break
' "${MOCHI_TEST_MESSENGER_CID:-}")"; then
  if [ -n "$SELF_CID" ]; then
    wdetail "live-fire target: owner's own Messenger chat ($SELF_CID)"
    live_send_expect "messenger live-fire: clean delivered to self" 0 -- $M send --cid "$SELF_CID" --text-stdin < "$FIX/clean.txt"
    live_send_expect "messenger live-fire: secret blocked, nothing sent" 1 -- $M send --cid "$SELF_CID" --text-stdin < "$FIX/secret2.txt"
  else
    bad "live-fire: no owner-only Messenger chat found" "the Messenger path was not exercised" "send yourself one message so an owner-only chat exists, then re-run. Live-fire fails closed on coverage loss — it never reports CLEAN for a path it did not test."
  fi
else
  bad "live-fire: MOCHI_TEST_MESSENGER_CID does not resolve to the owner's own chat" "" "point it at the conversation id of a chat containing only the owner, or unset it for auto-discovery. Live-fire never sends to anyone but the owner."
fi
fi

end_suite

# ------------------------------------------------------- C. coverage
# Attack-surface coverage: every known exfiltration path is mapped in
# references/attack-surface.md, and each path's stated control is verified
# to actually be in place — statically where the control is a mandate, and
# behaviorally where the control is a binary (the write-time guard probes).
begin_suite "C" "Attack-surface coverage (controls verified in place)"
if [ -f "$AGENTS_FILE" ]; then
  grep -q "bin/shims" "$AGENTS_FILE" && ok "agent manual mandates shim PATH" || bad "agent manual missing shim mandate" "" "add the shim-PATH export mandate to the agent manual (see the memory skill's references/data-protection.md), then re-run this audit."
  grep -q "brief-gate" "$AGENTS_FILE" && ok "agent manual mandates brief gating" || bad "agent manual missing brief-gate mandate" "" "add the brief-gate mandate to the agent manual, then re-run this audit."
else skip "agent manual not found" "$AGENTS_FILE"; fi
[ -f "$MEM_SKILL/references/subagent-briefing.md" ] && ok "briefing policy reference exists" || bad "references/subagent-briefing.md missing" "" "restore it from the muse-memory repo, then re-run this audit."
grep -q "Free-share zones" "$MEM_SKILL/references/data-protection.md" 2>/dev/null && ok "free-share zones defined in data-protection.md" || bad "data-protection.md missing free-share zones" "" "restore the Free-share zones section from the muse-memory repo, then re-run this audit."
if [ -n "$CRON_DIRS" ]; then
  while IFS=: read -r d; do
    [ -n "$d" ] || continue
    total=0; wired=0
    while IFS= read -r f; do
      total=$((total+1))
      grep -q 'bin/shims:$PATH' "$f" && wired=$((wired+1))
    done < <(find "$d" -name '*.md' 2>/dev/null)
    if [ "$total" -eq 0 ]; then skip "no prompt files in $d" "empty"
    elif [ "$wired" -eq "$total" ]; then ok "cron prompts in $d wire shim PATH ($wired/$total)"
    else bad "cron prompts in $d missing shim PATH" "$wired/$total wired" "add the shims PATH export to the unwired prompt files, then re-run this audit."; fi
  done <<< "${CRON_DIRS//:/$'\n'}"
else skip "cron prompt dirs not configured" "set MOCHI_CRON_PROMPT_DIRS"; fi
if [ "${MOCHI_MEMORY_AUDIT:-0}" = "1" ]; then
  audit_out="$("$MEM_SKILL/bin/memory-audit" 2>&1)"; arc=$?
  if [ "$arc" -eq 0 ]; then ok "memory-audit green"
  else
    # Never republish memory-audit evidence verbatim: its finding lines can
    # carry the very private literals being detected (the validator must not
    # amplify a leak). Counts only — the operator reads the tool's own output.
    flagged="$(printf '%s\n' "$audit_out" | grep -cE '^  (/|!)' || true)"
    bad "memory-audit reported findings (judge public vs private yourself)" "$flagged flagged line(s) — see the tool's own output locally; finding text is not republished here" "classify each finding public vs private first; only private items need action. See the memory skill's references/data-protection.md."
  fi
else skip "memory-audit run" "set MOCHI_MEMORY_AUDIT=1 to include"; fi

# F. scenario coverage map: every attack-surface scenario must be mapped
map_ids="$(grep -oE '^### [A-E][0-9]+\.' "$SKILL_DIR/references/attack-surface.md" | grep -oE '[A-E][0-9]+')"
map_count="$(printf '%s\n' $map_ids | grep -c .)"
unmapped=""
for sid in $map_ids; do
  grep -q "| $sid " "$SKILL_DIR/references/test-matrix.md" || unmapped="$unmapped $sid"
done
if [ -z "$unmapped" ]; then ok "all $map_count attack-surface scenarios mapped in test-matrix.md"
else bad "scenarios missing from the coverage map:$unmapped" "" "add a row for each to references/test-matrix.md section F, then re-run this audit."; fi

# B2/B3: public repos must not contain denylisted (private) literals
DENYLIST="$PERSONAL_MEMORY_ROOT/memory/.egress-denylist"
if [ -s "$DENYLIST" ]; then
  deny_tmp="$(mktemp)"
  grep -vE '^[[:space:]]*(#|$)' "$DENYLIST" > "$deny_tmp"
  if [ -s "$deny_tmp" ]; then
    leak=""
    for repo in "$SKILL_DIR" "$MEM_SKILL"; do
      if [ -d "$repo/.git" ]; then
        hits="$(cd "$repo" && git ls-files -z | xargs -0 grep -lF -f "$deny_tmp" 2>/dev/null || true)"
        [ -n "$hits" ] && leak="${leak}${repo}: $(printf '%s' "$hits" | tr '\n' ' ')"
      fi
    done
    if [ -n "$leak" ]; then bad "denylisted literals found in public repo files" "$leak" "remove the private literals from the public repos (B2/B3 scenarios), then re-run this audit."
    else ok "no denylisted literals in public repo tracked files (B2/B3)"; fi
  else skip "denylist empty" "no literals to check"; fi
  rm -f "$deny_tmp"
else skip "no egress denylist" "$DENYLIST missing or empty"; fi

# Fixture purity: every secret-shaped token in fixtures/corpus must be a
# declared synthetic value in bin/fixtures/SYNTHETIC.txt. The denylist
# check above catches the user's real literals; this catches any other
# undeclared secret-shaped value before it can ship in a public fixture.
SYNTH="$SKILL_DIR/bin/fixtures/SYNTHETIC.txt"
# Aligned with the stub's candidate shapes (test/stub-memory-skill/bin/patterns.sh):
# dashed SSN, bare 9-digit SSN, bare 16-digit card, 15-digit Amex, spaced/dashed
# 16-digit card, key prefixes, private-key blocks, and api_key=/password=/passwd=
# value shapes. Bare-digit shapes are intentionally conservative (see E3).
SHAPES='[0-9]{3}-[0-9]{2}-[0-9]{4}|\b[0-9]{9}\b|\b[0-9]{16}\b|\b3[47][0-9]{13}\b|[0-9]{4}[- ][0-9]{4}[- ][0-9]{4}[- ][0-9]{4}|sk_(live|test)_[A-Za-z0-9]+|sk-[A-Za-z0-9_-]{20,}|gsk_[A-Za-z0-9]+|AKIA[0-9A-Z]{16}|xox[bpas]-[A-Za-z0-9-]+|AIza[A-Za-z0-9_-]+|ghp_[A-Za-z0-9]+|BEGIN [A-Z ]*PRIVATE KEY|api[ _-]?key["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9_.-]{16,}|password["'"'"' ]*[:=]["'"'"' ]*[^ ]+|passwd["'"'"' ]*[:=]["'"'"' ]*[^ ]+'
if [ -f "$SYNTH" ]; then
  undeclared=""
  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    grep -qxF "$tok" "$SYNTH" || undeclared="${undeclared}${tok} "
  done < <(grep -hoE "$SHAPES" "$SKILL_DIR"/bin/fixtures/*.txt "$SKILL_DIR/bin/adversarial-corpus.txt" "$SKILL_DIR"/test/stub-memory-skill/bin/fixtures/*.txt 2>/dev/null | sort -u)
  if [ -n "$undeclared" ]; then bad "undeclared secret-shaped fixture values" "$undeclared" "declare each value as synthetic in bin/fixtures/SYNTHETIC.txt (after review), or remove it, then re-run this audit."
  else ok "all secret-shaped fixture values are declared synthetic"; fi
else bad "bin/fixtures/SYNTHETIC.txt missing" "" "restore it from the repo, then re-run this audit."; fi

# Write-time guard probes (D1/D2 in references/attack-surface.md): the
# catalog claims bin/memory-guard blocks secrets and flags figures/PII at
# write time. These probes verify the claim behaviorally instead of
# trusting the catalog. Privacy discipline: probes always pass explicit
# fixture paths and a controlled allowlist — never the default memory
# tree, never the installation's real allowlist — and stdout is discarded
# so only the exit code is compared. (Do not "simplify" these to scan the
# default tree: that would print real memory content into audit logs.)
guard_expect() { # <name> <fixture> <want_rc> [allowlist_file]
  local name="$1" fix="$2" want="$3" rc
  if [ -n "${4:-}" ]; then
    rc="$(timeout -k 10 30 env "MEMORY_FIGURE_ALLOWLIST=$4" "$MEM_SKILL/bin/memory-guard" "$FIX/$fix" >/dev/null 2>&1; echo $?)"
  else
    rc="$(timeout -k 10 30 env MEMORY_FIGURE_ALLOWLIST=/dev/null "$MEM_SKILL/bin/memory-guard" "$FIX/$fix" >/dev/null 2>&1; echo $?)"
  fi
  if [ "$rc" -eq 124 ]; then
    bad "memory-guard: $name" "memory-guard timed out after 30s (did not answer in time)" \
      "investigate why memory-guard hung on fixture $fix; do not trust write-time verdicts from this installation until it answers."
    return
  fi
  if [ "$rc" -eq "$want" ]; then ok "memory-guard: $name (rc=$rc)"
  else
    case "$want" in
      1) sug="block-tier content was not blocked at write time. Check the secret patterns in the target's bin/memory-guard, then re-run this audit.";;
      2) sug="review-tier content was not flagged at write time. Check the figure/PII patterns in the target's bin/memory-guard, then re-run this audit.";;
      *) sug="benign content was flagged at write time (rc=$rc). Narrow the over-matching pattern in the target's bin/memory-guard, then re-run this audit.";;
    esac
    bad "memory-guard: $name" "want rc=$want, got rc=$rc" "$sug"
  fi
}
guard_expect "secret blocked" secret.txt 1
guard_expect "figure flagged for review" figure.txt 2
guard_expect "phone flagged for review" phone.txt 2
guard_expect "clean passes" clean.txt 0
printf '%s\n' "$(cat "$FIX/figure.txt")" > "$T/allow-figure.txt"
guard_expect "allowlisted figure exempted" figure.txt 0 "$T/allow-figure.txt"
printf '%s\n' "$(cat "$FIX/secret.txt")" > "$T/allow-secret.txt"
guard_expect "allowlisted secret still blocked (allowlist never exempts secrets)" secret.txt 1 "$T/allow-secret.txt"
# No-args stdin modes (2026-09-22 regression): a no-args invocation whose
# stdin is an idle pipe (cron, $(...)) must not hang on `cat` forever, and
# memory-guard must not false-clean by scanning an empty temp file.
# PERSONAL_MEMORY_ROOT points at a scratch tree so the fallback tree scan
# never touches the real memory; the planted figure is a declared
# synthetic corpus value, never real data.
mkdir -p "$T/emptyroot/memory/trace"
# Planted figure is a declared synthetic corpus value (fig_dollar), never
# real data: any nonzero rc proves the fallback scanned the tree, while
# the old false-clean bug would return rc=0 on an empty temp file.
printf 'note budget $12,500 per month\n' > "$T/emptyroot/memory/trace/t.md"
stdin_probe() { # <name> <binary> <want_rc>
  local name="$1" bin="$2" want="$3" rc sleeper
  mkfifo "$T/idlepipe" 2>/dev/null || true
  sleep 30 > "$T/idlepipe" 2>/dev/null & sleeper=$!
  rc="$(timeout -k 5 20 env PERSONAL_MEMORY_ROOT="$T/emptyroot" "$bin" < "$T/idlepipe" >/dev/null 2>&1; echo $?)"
  kill "$sleeper" 2>/dev/null; wait "$sleeper" 2>/dev/null; rm -f "$T/idlepipe"
  if [ "$rc" -eq 124 ]; then
    bad "$name" "hung on an idle pipe (killed by timeout)" \
      "the no-args stdin path must probe for data with a timeout instead of blocking on cat; see the 2026-09-22 memory-guard fix."
  elif [ "$rc" -eq "$want" ]; then ok "$name (rc=$rc)"
  else bad "$name" "want rc=$want, got rc=$rc" "check the no-args stdin handling in $bin."
  fi
}
stdin_probe "memory-guard: idle-pipe stdin falls back to the tree scan (planted figure found)" "$MEM_SKILL/bin/memory-guard" 2
rm -f "$T/emptyroot/memory/trace/t.md"
stdin_probe "memory-guard: idle-pipe stdin on a clean tree, no hang" "$MEM_SKILL/bin/memory-guard" 0
stdin_probe "memory-egress-check: idle-pipe stdin is clean, no hang" "$MEM_SKILL/bin/memory-egress-check" 0
# Public-pattern class exemptions (E1): the auditor can rule a literal CLASS
# public (e.g. market-price quotes whose values change daily, so fixed
# strings cannot cover them). Controlled pattern file and temp fixtures —
# never the installation's real ones.
printf '%s\n' 'MU ~\$[0-9,]+(\.[0-9]+)?' > "$T/pp.txt"
printf 'MU ~$977 after the news\n' > "$T/market.txt"
# The "patterns never exempt secrets" probe must use a DECLARED synthetic
# block-tier token (first want=1 adversarial-corpus case): the stub target
# blocks by lookup in its declared set, so an arbitrary secret-shaped
# literal would only fail closed to review-tier (rc=2) there — while the
# real target blocks any secret shape. A declared token gives rc=1 on both.
declared_block="$(grep -v '^[[:space:]]*#' "$SKILL_DIR/bin/adversarial-corpus.txt" | grep -m1 '|1|' | cut -d'|' -f3-)"
printf '%s\n' 'MU ~$977 after the news' "$declared_block" > "$T/market-secret.txt"
pp_expect() { # <name> <file> <want_rc> <gate: guard|egress>
  local name="$1" f="$2" want="$3" gate="$4" rc gatebin
  if [ "$gate" = guard ]; then gatebin="$MEM_SKILL/bin/memory-guard"
  else gatebin="$MEM_SKILL/bin/memory-egress-check"; fi
  rc="$(timeout -k 10 30 env "MEMORY_PUBLIC_PATTERNS=$T/pp.txt" "MEMORY_FIGURE_ALLOWLIST=/dev/null" "MEMORY_EGRESS_ALLOWLIST=/dev/null" "$gatebin" "$f" >/dev/null 2>&1; echo $?)"
  if [ "$rc" -eq 124 ]; then
    bad "$gate: $name" "$gate timed out after 30s (did not answer in time)" \
      "investigate why $gate hung; do not trust verdicts until it answers."
    return
  fi
  if [ "$rc" -eq "$want" ]; then ok "$gate: $name (rc=$rc)"
  else bad "$gate: $name" "want rc=$want, got rc=$rc" \
    "check the public-pattern exemption in the target's $gatebin, then re-run this audit."
  fi
}
pp_expect "public-pattern market price exempted" "$T/market.txt" 0 guard
pp_expect "public pattern never exempts secrets" "$T/market-secret.txt" 1 guard
pp_expect "public-pattern market price exempted" "$T/market.txt" 0 egress
pp_expect "public pattern never exempts secrets" "$T/market-secret.txt" 1 egress

end_suite

# ------------------------------------------------------------- D. gate log
begin_suite "D" "Gate audit-log review"
if [ -f "$REAL_LOG" ]; then
  total="$(wc -l < "$REAL_LOG")"
  printf '%s\n' "$total gate decisions logged" | wdetail
  for v in BLOCKED needs-approval approved-override detector-error; do
    n="$(grep -c "| $v$" "$REAL_LOG" 2>/dev/null || true)"
    [ "$n" -gt 0 ] && printf '%s\n' "$v: $n" | wdetail
  done
  # Contexts are never republished: on real installations they carry
  # recipient addresses and free-form brief task text. Counts only — the
  # operator reviews the log locally.
  if grep -q "| approved-override$" "$REAL_LOG"; then
    printf '%s\n' "--- overrides: $(grep -c "| approved-override$" "$REAL_LOG") logged (contexts withheld — review the log locally) ---" | wdetail
  fi
  if grep -q "| BLOCKED$" "$REAL_LOG"; then
    printf '%s\n' "--- blocked attempts: $(grep -c "| BLOCKED$" "$REAL_LOG") logged (contexts withheld) ---" | wdetail
  fi
  if [ "$total" -gt 0 ]; then ok "gate log reviewed ($total decisions)"
  else warn "gate log is empty — the gate has not been exercised in real operation" "an empty log cannot prove the gate is actually wired into daily operation (the A7 bypass scenario). Verify the shim PATH is honored by scheduled workers, then re-run."
  fi
else skip "gate log not found" "$(shorten "$REAL_LOG") (no sends attempted yet)"; fi

end_suite

# ------------------------------------------------------------- E. residuals
begin_suite "E" "Known residuals (reported, never silent)"
{
printf '%s\n' "- browser-task sends: separate VM, shims can't reach; brief-level instruction only"
printf '%s\n' "- absolute-path bypass of shims: forbidden by policy, not technically preventable"
printf '%s\n' "- voice calls: phone tool's own confirmation flow (out of text-gate scope)"
printf '%s\n' "- brief-gate runs on mandate (no syscall interception for brief text)"
printf '%s\n' "- compositional/chunked exfiltration across calls: the gate judges each send in isolation; content split across sends is never reassembled"
printf '%s\n' "- out-of-band egress: curl, webhooks, unshimmed CLIs, and any other non-shimmed path leave the machine without hitting the gate — only shimmed send paths are gated"
printf '%s\n' "- A7 cron PATH check is static/syntactic: it proves the mandate is written in the prompt files, not that every scheduled worker honored it at runtime"
printf '%s\n' "- public-pattern exemption is line-scoped in the review tier: a private figure sharing a line with a public-pattern match is also exempted from review (the BLOCK tier is computed before any exemption and is unaffected)"
printf '%s\n' "- bare 9-digit SSN shapes are flagged (deliberately conservative) — false-positive risk documented as scenario E3"
printf '%s\n' "- attachment/binary inspection: open gap (B4) — attachments are not unpacked or scanned"
printf '%s\n' "- nested/part-level encodings inside MIME: the shim decodes the outer \`raw\` once; a secret inside a base64 MIME part (or any non-base64 encoding) is not decoded — known gap"
printf '%s\n' "- gmail messages import/insert: NOT gated (open gap) — only send/update paths are intercepted"
printf '%s\n' "- chat/calendar/settings-plane beyond Gmail settings mutations: no shim coverage (open gap)"
printf '%s\n' "- malformed/undecodable raw-MIME send: refuses closed (the malformed mail is dropped, not leaked) — the trade-off is visible by design"
} | wdetail

end_suite

rm -rf "$T"
print_summary
[ "$FAIL" -eq 0 ]
