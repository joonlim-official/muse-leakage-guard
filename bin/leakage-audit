#!/usr/bin/env bash
# leakage-audit: validate a private-memory leakage protection installation.
#
# Checks installation integrity, red-teams every gate and send path with
# synthetic payloads, statically verifies coverage of the attack surface,
# and reviews the gate audit log. By default nothing is ever really sent:
# send-path tests run against fake "real" binaries via MOCHI_REAL_* overrides.
# Opt-in live-fire mode (MOCHI_LIVE_FIRE=1) exercises the genuine end-to-end
# path instead: real sends to the owner's own accounts, synthetic payloads
# only. The report always labels which mode ran (SIMULATED vs LIVE-FIRE).
#
# Configuration (env wins; $SKILL_DIR/local.env inside the skill dir is sourced
# if present and only fills variables not already set in the environment.
# local.env is gitignored — keep installation-specific values there.
# Precedence: explicit environment > local.env > built-in default):
#   PERSONAL_MEMORY_SKILL   memory skill under test (default ~/workspace/skills/personal-memory-system)
#   PERSONAL_MEMORY_ROOT    memory root passed through to the gates (default ~)
#   MOCHI_AGENTS_FILE       agent operating manual (default ~/AGENTS.md)
#   MOCHI_CRON_PROMPT_DIRS  colon-separated dirs of scheduled-job prompts (default: empty = skip)
#   MOCHI_EGRESS_LOG        gate audit log (default ~/workspace/memory-sync/egress-gate.log)
#   MOCHI_MEMORY_AUDIT=1    also run the memory skill's own memory-audit
#   MOCHI_LIVE_FIRE=1       opt-in: suite B sends for real to the owner's own
#                           accounts (default: simulated via fake binaries).
#                           Must be set inline in the invoking environment;
#                           a value from local.env alone is ignored. Never export.
#   MOCHI_LIVE_FIRE_NONINTERACTIVE=1  allow live-fire without a TTY (default:
#                           refused when stdin is not a TTY or $CI is set).
#   MOCHI_TEST_EMAIL        live-fire email recipient (no default — required).
#                           Must be the owner's own address; verified against
#                           the Gmail profile before any send. Never anyone else's.
#   MOCHI_TEST_MESSENGER_CID  live-fire Messenger target conversation id.
#                           Must resolve to the owner's own chat (default:
#                           auto-discovered); anything else fails closed.
#
# Usage: bin/leakage-audit [-h|--help]
# Exit 0 = all checks pass (skips don't fail). Exit 1 = at least one FAIL.
# Exit 2 = usage error or refused live-fire (environment, not findings).
set -u

case "${1:-}" in
  -h|--help) sed -n '2,/^#$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
esac
if [ $# -gt 0 ]; then echo "leakage-audit: unknown option: $1 (usage: bin/leakage-audit [-h|--help])" >&2; exit 2; fi

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Snapshot explicit environment so local.env can only supply defaults,
# never override the operator's invocation (and never arm live-fire).
_LIVE_FIRE_ENV="${MOCHI_LIVE_FIRE:-}"
_saved_vars=()
for _v in PERSONAL_MEMORY_SKILL PERSONAL_MEMORY_ROOT MOCHI_AGENTS_FILE \
  MOCHI_CRON_PROMPT_DIRS MOCHI_EGRESS_LOG MOCHI_MEMORY_AUDIT MOCHI_LIVE_FIRE \
  MOCHI_LIVE_FIRE_NONINTERACTIVE MOCHI_TEST_EMAIL MOCHI_TEST_MESSENGER_CID; do
  if [ -n "${!_v+x}" ]; then _saved_vars+=("$_v=${!_v}"); fi
done
[ -f "$SKILL_DIR/local.env" ] && . "$SKILL_DIR/local.env"
if [ "${#_saved_vars[@]}" -gt 0 ]; then
  for _kv in "${_saved_vars[@]}"; do export "$_kv"; done
fi
unset _v _kv _saved_vars

MEM_SKILL="${PERSONAL_MEMORY_SKILL:-$HOME/workspace/skills/personal-memory-system}"
export PERSONAL_MEMORY_ROOT="${PERSONAL_MEMORY_ROOT:-$HOME}"
AGENTS_FILE="${MOCHI_AGENTS_FILE:-$HOME/AGENTS.md}"
CRON_DIRS="${MOCHI_CRON_PROMPT_DIRS:-}"
GATE_LOG="${MOCHI_EGRESS_LOG:-$HOME/workspace/memory-sync/egress-gate.log}"
REAL_LOG="$GATE_LOG"   # the configured log; validation below uses a temp one
FIX="$SKILL_DIR/bin/fixtures"
SHIMDIR="$MEM_SKILL/bin/shims"

# Validation mode, labelled in the header, the summary, and the HTML report
# so a reader never mistakes a simulated run for a live-fire one.
# Live-fire is strictly per-invocation opt-in: it must be set inline in the
# invoking environment. A MOCHI_LIVE_FIRE=1 that came only from local.env
# is ignored with a loud warning — a stale file must never arm real sends.
if [ "${_LIVE_FIRE_ENV:-}" != "1" ] && [ "${MOCHI_LIVE_FIRE:-}" = "1" ]; then
  echo "leakage-audit: WARNING: MOCHI_LIVE_FIRE=1 came from local.env, not the invoking environment;" >&2
  echo "leakage-audit: WARNING: ignoring it. Set MOCHI_LIVE_FIRE=1 inline to opt in per run." >&2
  MOCHI_LIVE_FIRE=""
fi
unset _LIVE_FIRE_ENV
if [ "${MOCHI_LIVE_FIRE:-}" = "1" ]; then
  if { [ -n "${CI:-}" ] || [ ! -t 0 ]; } && [ "${MOCHI_LIVE_FIRE_NONINTERACTIVE:-}" != "1" ]; then
    echo "leakage-audit: refusing live-fire in a non-interactive context (stdin is not a TTY or \$CI is set)." >&2
    echo "leakage-audit: set MOCHI_LIVE_FIRE_NONINTERACTIVE=1 to override explicitly." >&2
    exit 2
  fi
  AUDIT_MODE="LIVE-FIRE (real sends to owner's own accounts; synthetic payloads only)"
  AUDIT_MODE_SHORT="LIVE-FIRE"
else
  AUDIT_MODE="SIMULATED (fake binaries; nothing is sent)"
  AUDIT_MODE_SHORT="SIMULATED"
fi

PASS=0; FAIL=0; SKIPPED=0
SUITE_LETTER=""; SUITE_NAME=""; sP=0; sF=0; sS=0
ROWS=""; FINDINGS=""

# Report width: override with MOCHI_REPORT_WIDTH, else terminal width,
# else a mobile-friendly 48. Clamped to [40, 76].
WIDTH="${MOCHI_REPORT_WIDTH:-}"
if [ -z "$WIDTH" ]; then WIDTH="$(tput cols 2>/dev/null || echo 48)"; fi
case "$WIDTH" in ''|*[!0-9]*) WIDTH=48;; esac
[ "$WIDTH" -lt 40 ] && WIDTH=40
[ "$WIDTH" -gt 76 ] && WIDTH=76
RULE="$(printf '─%.0s' $(seq 1 $((WIDTH-2))))"
BOLD_RULE="$(printf '═%.0s' $(seq 1 $((WIDTH-2))))"

shorten() { printf '%s' "${1//$HOME/\~}"; }   # $HOME -> ~ for display

# Machine-readable sentinels for bin/leakage-report: structural lines the
# evidence path cannot accidentally produce (a hostile check name or wrapped
# CLI output can never forge them). Emitted only when MOCHI_AUDIT_MACHINE=1 —
# leakage-report sets it; terminal output is unchanged.
msent() {
  [ "${MOCHI_AUDIT_MACHINE:-}" = "1" ] || return 0
  local p="$*"
  p="${p//$'\n'/ }"; p="${p//@@@/[at]}"
  printf '@@@ %s\n' "$p"
}

# Wrapped check line: "  ✓ text", continuations indented.
wcheck() {
  printf '%s\n' "$*" | fold -s -w "$((WIDTH-4))" | sed 's/ *$//' | sed '1s/^/  /; 2,$s/^/    /'
}
# Wrapped detail line: hard break so evidence never scrolls sideways.
# Reads stdin or args; each logical line wraps independently.
wdetail() {
  { if [ $# -gt 0 ]; then printf '%s\n' "$*"; else cat; fi; } \
    | while IFS= read -r line; do
        msent "CTX $line"
        printf '%s\n' "$line" | fold -w "$((WIDTH-6))" | sed 's/ *$//' | sed '1s/^/    /; 2,$s/^/      /'
      done
}

ok()   { PASS=$((PASS+1)); msent "CHECK PASS $(shorten "$1")"; wcheck "✓ $(shorten "$1")"; }
# bad <name> [evidence] [suggestion] — every failure carries a concrete
# suggested remediation. This skill validates and suggests; it never
# applies fixes — remediation belongs to the memory skill / the agent.
bad()  { FAIL=$((FAIL+1))
         _blabel="$1"; [ -n "$SUITE_LETTER" ] && _blabel="[$SUITE_LETTER] $1"
         msent "CHECK FAIL $(shorten "$_blabel")"
         wcheck "✗ $(shorten "$_blabel")"
         FINDINGS="${FINDINGS}$(wcheck "✗ $(shorten "$_blabel")")"$'\n'
         if [ -n "${2:-}" ]; then
           printf '%s\n' "$2" | wdetail
           FINDINGS="${FINDINGS}$(printf '%s\n' "$2" | wdetail)"$'\n'
         fi
         if [ -n "${3:-}" ]; then
           printf '%s\n' "Suggestion: $3" | wdetail
           FINDINGS="${FINDINGS}$(printf '%s\n' "Suggestion: $3" | wdetail)"$'\n'
         fi
         unset _blabel; }
skip() { SKIPPED=$((SKIPPED+1)); msent "CHECK SKIP $(shorten "$1") [$(shorten "$2")]"; wcheck "– $(shorten "$1") [$(shorten "$2")]"; }

begin_suite() { # <letter> <name>
  SUITE_LETTER="$1"; SUITE_NAME="$2"; sP=$PASS; sF=$FAIL; sS=$SKIPPED
  msent "SUITE $1 $2"
  printf '\n'
  printf '  %s. %s\n' "$1" "$2" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/     /'
  printf '  %s\n' "$RULE"
}
end_suite() {
  local p=$((PASS-sP)) f=$((FAIL-sF)) s=$((SKIPPED-sS)) label
  label="${SUITE_NAME%% (*}"   # suite name without parenthetical subtitle
  msent "ENDSUITE $SUITE_LETTER $p $f $s"
  printf '  %s\n' "$RULE"
  printf '    %d passed · %d failed · %d skipped\n' "$p" "$f" "$s"
  ROWS="${ROWS}${SUITE_LETTER}|${label}|${p}|${f}|${s}"$'\n'
}

print_header() {
  printf '\n  muse-leakage-guard · leakage-audit\n'
  printf '  %s\n' "$(date '+%Y-%m-%d %H:%M %Z')"
  msent "TS $(date '+%Y-%m-%d %H:%M %Z')"
  printf '%s\n' "target: $(shorten "$MEM_SKILL")" | fold -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "TARGET $(shorten "$MEM_SKILL")"
  printf '%s\n' "mode: $AUDIT_MODE" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "MODE $AUDIT_MODE_SHORT"
  printf '  %s\n' "$BOLD_RULE"
}

print_summary() {
  printf '\n  Summary\n'
  printf '  %s\n' "$RULE"
  if [ "$WIDTH" -ge 56 ]; then
    printf '  %-32s %5s %5s %5s\n' "Suite" "Pass" "Fail" "Skip"
    printf '  %s\n' "$RULE"
    while IFS='|' read -r l lab p f s; do
      [ -n "$l" ] || continue
      printf '  %-32s %5d %5d %5d\n' "$l. $lab" "$p" "$f" "$s"
    done <<< "$ROWS"
    printf '  %s\n' "$RULE"
    printf '  %-32s %5d %5d %5d\n' "Total" "$PASS" "$FAIL" "$SKIPPED"
  else
    while IFS='|' read -r l lab p f s; do
      [ -n "$l" ] || continue
      printf '  %s. %s\n' "$l" "$lab"
      printf '    %d passed · %d failed · %d skipped\n' "$p" "$f" "$s"
    done <<< "$ROWS"
    printf '  %s\n' "$RULE"
    printf '%s\n' "Total: $PASS passed · $FAIL failed · $SKIPPED skipped" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  fi
  if [ "$FAIL" -eq 0 ]; then
    if [ "$SKIPPED" -gt 0 ]; then
      v="VERDICT: CLEAN — all $PASS checks passed ($SKIPPED skipped)."
    else
      v="VERDICT: CLEAN — all $PASS checks passed."
    fi
  else
    v="VERDICT: ATTENTION — $FAIL finding(s) need review."
  fi
  printf '%s\n' "mode: $AUDIT_MODE" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "TOTAL $PASS $FAIL $SKIPPED"
  printf '%s\n' "$v" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  msent "VERDICT $v"
  if [ "$FAIL" -gt 0 ]; then
    printf '\n  Findings\n'
    printf '  %s\n' "$RULE"
    printf '%s\n' "$FINDINGS"
  fi
  printf '\n'
}

print_header

# ---------------------------------------------------------------- A. install
begin_suite "A" "Installation integrity"
for f in bin/egress-gate bin/brief-gate bin/memory-egress-check; do
  if [ -x "$MEM_SKILL/$f" ]; then ok "$f present and executable"
  else bad "$f missing or not executable" "" "restore it from the muse-memory repo and chmod +x, then re-run this audit."; fi
done
for f in bin/egress-gate bin/brief-gate bin/memory-egress-check bin/shims/hatch_gws_cli bin/shims/hatch_messenger_cli; do
  if bash -n "$MEM_SKILL/$f" 2>/dev/null; then ok "$f parses"
  else bad "$f has syntax errors" "" "run: bash -n $MEM_SKILL/$f to locate the error, fix it, then re-run this audit."; fi
done
for cli in hatch_gws_cli hatch_messenger_cli; do
  if [ ! -x "$SHIMDIR/$cli" ]; then bad "shim $cli missing" "" "restore bin/shims/$cli from the muse-memory repo; every agent context must put the shims dir first on PATH."; continue; fi
  resolved="$(PATH="$SHIMDIR:$PATH" command -v "$cli")"
  if [ "$resolved" = "$SHIMDIR/$cli" ]; then ok "shim $cli shadows real binary on PATH"
  else bad "shim $cli does NOT shadow (resolves to $resolved)" "" "fix PATH ordering: export PATH=\"<memory-skill>/bin/shims:\$PATH\" before any other entry providing $cli."; fi
  real_found=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    [ "$d" = "$SHIMDIR" ] && continue
    if [ -x "$d/$cli" ]; then real_found=1; break; fi
  done <<< "${PATH//:/$'\n'}"
  if [ "$real_found" -eq 1 ]; then ok "real $cli discoverable behind shim"
  else bad "real $cli not found on PATH — shim has nothing to delegate to" "" "install the real CLI or extend PATH so the shim has a delegate; a shim with no delegate breaks every send."; fi
done

# Fixture integrity: a missing or empty fixture makes its check vacuous
# (an empty "clean" fixture passes trivially; a missing block-tier fixture
# can error into a misleading verdict). Fail closed on fixture rot.
for fix in clean.txt secret.txt secret2.txt ssn.txt card.txt figure.txt phone.txt; do
  if [ ! -f "$FIX/$fix" ]; then bad "fixture $fix missing" "" "restore bin/fixtures/$fix from the repo, then re-run this audit."
  elif [ ! -s "$FIX/$fix" ]; then bad "fixture $fix is empty (vacuous test)" "" "restore the fixture content from the repo, then re-run this audit."
  else ok "fixture $fix present and non-empty"; fi
done
corpus_cases="$(grep -vcE '^[[:space:]]*(#|$)' "$SKILL_DIR/bin/adversarial-corpus.txt" 2>/dev/null || true)"
if [ "$corpus_cases" -ge 1 ]; then ok "adversarial corpus has $corpus_cases cases"
else bad "adversarial corpus is empty — 0/0 would be a vacuous pass" "" "restore bin/adversarial-corpus.txt from the repo, then re-run this audit."; fi

end_suite

# ------------------------------------------------- B. red team (fake sends)
if [ "$AUDIT_MODE_SHORT" = "LIVE-FIRE" ]; then
  begin_suite "B" "Gate effectiveness (red team, LIVE-FIRE: real sends to own accounts)"
else
  begin_suite "B" "Gate effectiveness (red team, synthetic payloads)"
fi
T="$(mktemp -d)"
LIVE_FIRE="${MOCHI_LIVE_FIRE:-}"
if [ "$LIVE_FIRE" = "1" ]; then
  # Live-fire: the shims delegate to the genuine CLIs (no MOCHI_REAL_* overrides),
  # exercising the true end-to-end path: shim -> gate -> real binary.
  # Real sends go to the owner's own accounts ONLY (see below); payloads stay
  # synthetic. Drive share tests stay simulated — a live run must never
  # grant real access to anyone.
  #
  # Integrity: a stale MOCHI_REAL_* override (e.g. from local.env) would make
  # a "live-fire" run exercise fake binaries while the report claims LIVE-FIRE.
  # Refuse that confusion — unset them loudly.
  for _rv in MOCHI_REAL_HATCH_GWS_CLI MOCHI_REAL_HATCH_MESSENGER_CLI; do
    if [ -n "${!_rv:-}" ]; then
      wdetail "LIVE-FIRE: unsetting stale $_rv (was: ${!_rv}) — live-fire must use the genuine CLIs."
      unset "$_rv"
    fi
  done
  unset _rv
  wdetail "LIVE-FIRE: real sends to the owner's own accounts; synthetic payloads only."
else
  mkdir -p "$T/fakebin"
  cat > "$T/fakebin/real-gws" <<'EOF'
#!/usr/bin/env bash
# Invocation sentinel: the audit asserts on this file, not on stdout text
# (a crashing binary could echo a marker without touching it). Arg values are
# hashed, never echoed — failure evidence must not carry fixture content.
touch "$T_INVOKED_DIR/invoked-any"
echo "REAL-GWS-INVOKED argv-sha256=$(printf '%s' "$*" | sha256sum | cut -d' ' -f1)"
exit 0
EOF
  cat > "$T/fakebin/real-msg" <<'EOF'
#!/usr/bin/env bash
touch "$T_INVOKED_DIR/invoked-any"
echo "REAL-MSG-INVOKED argv-sha256=$(printf '%s' "$*" | sha256sum | cut -d' ' -f1)"
echo "---stdin---"; cat; echo "---endstdin---"
exit 0
EOF
  chmod +x "$T/fakebin"/real-*
  export T_INVOKED_DIR="$T"
  export MOCHI_REAL_HATCH_GWS_CLI="$T/fakebin/real-gws"
  export MOCHI_REAL_HATCH_MESSENGER_CLI="$T/fakebin/real-msg"
fi
export MOCHI_EGRESS_LOG="$T/gate.log"   # keep validation out of the real log
export PATH="$SHIMDIR:$PATH"

gate_expect() { # <name> <gate:egress|brief> <fixture> <want_rc>
  local name="$1" gate="$2" fix="$3" want="$4" rc
  if [ "$gate" = brief ]; then
    timeout 30 "$MEM_SKILL/bin/brief-gate" --brief-file "$FIX/$fix" --task "leakage-audit:$name" >/dev/null 2>&1; rc=$?
  else
    timeout 30 "$MEM_SKILL/bin/egress-gate" --content-file "$FIX/$fix" --context "leakage-audit:$name" >/dev/null 2>&1; rc=$?
  fi
  if [ "$rc" -eq 124 ]; then
    bad "$name" "gate timed out after 30s (did not refuse or pass in time)" \
      "investigate why the gate hung on fixture $fix; do not trust verdicts from this installation until it answers."
    return
  fi
  if [ "$rc" -eq "$want" ]; then ok "$name (rc=$rc)"
  else
    case "$want" in
      1) sug="block-tier payload passed the gate. Tighten SECRET_RE/BLOCK_RE in bin/memory-egress-check until fixture $fix matches, then re-run this audit.";;
      2) sug="review-tier content was not flagged. Check FIGURE_RE/PHONE_RE and the denylist in bin/memory-egress-check against fixture $fix, then re-run this audit.";;
      *) sug="benign content was gated (rc=$rc). Narrow the over-matching pattern — or, if the user ruled the literal public, add it to the installation's .egress-allowlist (review tier only; never for block-tier shapes).";;
    esac
    bad "$name" "want rc=$want, got rc=$rc" "$sug"
  fi
}
send_expect() { # <name> <want_rc> <want_invoked 0|1> -- cmd...
  local name="$1" want_rc="$2" want_inv="$3"; shift 3
  [ "${1:-}" = "--" ] && shift
  local out rc inv=0
  rm -f "$T/invoked-any"   # per-check sentinel; the fake real binary touches it
  out="$(timeout 30 "$@" 2>&1)"; rc=$?
  if [ "$rc" -eq 124 ]; then
    bad "$name" "send timed out after 30s (the shim or gate hung)" \
      "investigate the shim path for this subcommand; do not trust verdicts from this installation until sends answer."
    return
  fi
  [ -f "$T/invoked-any" ] && inv=1
  if [ "$rc" -eq "$want_rc" ] && [ "$inv" -eq "$want_inv" ]; then ok "$name (rc=$rc invoked=$inv)"
  else
    if [ "$want_inv" = "0" ] && [ "$inv" = "1" ]; then
      sug="a send that should have been stopped reached the real binary. Check that bin/shims routes this subcommand through bin/egress-gate."
    elif [ "$want_rc" = "0" ] && [ "$rc" -ne 0 ]; then
      sug="a clean send was stopped (rc=$rc). Check the gate patterns for over-matching, or the shim's subcommand routing."
    else
      sug="verdict or invocation mismatch. Reproduce with the fixture, then inspect the shim and gate path for this subcommand."
    fi
    bad "$name" "want rc=$want_rc invoked=$want_inv, got rc=$rc invoked=$inv :: $(printf '%s' "$out" | head -3 | tr '\n' '|')" "$sug"
  fi
}

for g in egress brief; do
  gate_expect "$g gate: clean passes"            "$g" clean.txt   0
  gate_expect "$g gate: fake api key blocked"   "$g" secret.txt  1
  gate_expect "$g gate: fake private key blocked" "$g" secret2.txt 1
  gate_expect "$g gate: test SSN blocked"       "$g" ssn.txt     1
  gate_expect "$g gate: test card blocked"      "$g" card.txt    1
  gate_expect "$g gate: figure needs approval"  "$g" figure.txt  2
  gate_expect "$g gate: phone needs approval"   "$g" phone.txt   2
done

G=hatch_gws_cli; M=hatch_messenger_cli

if [ "$LIVE_FIRE" != "1" ]; then
# --- simulated send path: fake "real" binaries; nothing is ever sent ---
send_expect "gmail +send clean passes" 0 1 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/clean.txt")"
send_expect "gmail +send secret blocked" 1 0 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/secret.txt")"
send_expect "gmail +reply ssn blocked" 1 0 -- $G gmail +reply --message-id x --body "$(cat "$FIX/ssn.txt")"
send_expect "gmail +send figure refused w/o approval" 2 0 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/figure.txt")"
send_expect "gmail +send figure allowed with approval" 0 1 -- env MOCHI_EGRESS_APPROVED=1 $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/figure.txt")"
send_expect "gmail +send --draft with secret passes through (stays in account)" 0 1 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/secret.txt")" --draft
send_expect "gmail non-send passes through" 0 1 -- $G gmail +triage --max 1

RAW_MIME="$(python3 -c "import base64,sys; sys.stdout.write(base64.urlsafe_b64encode(open('$FIX/card.txt','rb').read()).decode())")"
send_expect "raw messages.send with card in MIME blocked" 1 0 -- $G gmail users messages send --params "{\"raw\":\"$RAW_MIME\"}"

send_expect "messenger send clean passes" 0 1 -- $M send --cid '999' --text-stdin < "$FIX/clean.txt"
send_expect "messenger send secret blocked" 1 0 -- $M send --cid '999' --text-stdin < "$FIX/secret2.txt"
send_expect "messenger threads passes through" 0 1 -- $M threads --limit 1 < /dev/null

send_expect "drive permissions create refused w/o approval" 2 0 -- $G drive permissions create --params '{}'
send_expect "drive permissions create allowed with approval" 0 1 -- env MOCHI_EGRESS_APPROVED=1 $G drive permissions create --params '{}'
send_expect "drive files list passes through (free zone)" 0 1 -- $G drive files list

# stdin replay integrity: what the fake binary received must equal the fixture
out="$($M send --cid '999' --text-stdin < "$FIX/clean.txt" 2>/dev/null)"
replayed="$(printf '%s' "$out" | sed -n '/---stdin---/,/---endstdin---/p' | sed '1d;$d')"
if [ "$replayed" = "$(cat "$FIX/clean.txt")" ]; then ok "messenger stdin replayed byte-identical on allow"
else bad "messenger stdin replay mismatch" "" "the shim altered stdin when replaying to the real binary. Inspect the shim's stdin handling before it reaches the delegate."; fi
else
# --- live-fire: small representative subset, real sends to the owner's own accounts ---
# Payloads are the same synthetic fixtures; only the transport is real.
live_send_expect() { # <name> <want_rc> -- cmd...
  local name="$1" want="$2"; shift 2
  [ "${1:-}" = "--" ] && shift
  local out rc
  out="$("$@" 2>&1)"; rc=$?
  if [ "$rc" -eq "$want" ]; then ok "$name (rc=$rc)"
  else bad "$name" "want rc=$want, got rc=$rc :: $(printf '%s' "$out" | head -3 | tr '\n' '|')" \
    "a live-fire send behaved unexpectedly. Inspect the shim and gate path for this subcommand before re-running with MOCHI_LIVE_FIRE=1."
  fi
}

LIVE_EMAIL="${MOCHI_TEST_EMAIL:-}"
if [ -z "$LIVE_EMAIL" ]; then
  bad "live-fire: no test email configured" "" "set MOCHI_TEST_EMAIL to the owner's own address (never anyone else's). There is no default."
else
  # Verify the target belongs to the owner: the Gmail profile's address must
  # match, case-insensitively. Fail closed on mismatch or when the identity
  # cannot be determined — never trust the address blindly. (Read-only call;
  # the shim passes non-send subcommands straight through to the real CLI.)
  _profile_addr="$("$G" gmail users getProfile --params '{"userId":"me"}' --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("emailAddress",""))' 2>/dev/null)"
  if [ -z "$_profile_addr" ]; then
    bad "live-fire: cannot determine Gmail identity" "" "the getProfile check failed; refusing to send without verifying the target belongs to the owner."
  elif [ "${_profile_addr,,}" != "${LIVE_EMAIL,,}" ]; then
    bad "live-fire: target is not the owner's address" "MOCHI_TEST_EMAIL domain=${LIVE_EMAIL##*@} vs Gmail identity domain=${_profile_addr##*@} (full addresses redacted)" "set MOCHI_TEST_EMAIL to the owner's own address (never anyone else's)."
  else
    wdetail "live-fire target: $LIVE_EMAIL (verified against the Gmail profile)"
    MARK="leakage-audit live-fire $(date +%Y%m%d-%H%M%S)-$$"
    if [ -t 0 ]; then
      wdetail "Sending 3 test emails to the owner's own address ($LIVE_EMAIL). Ctrl-C now to abort."
      sleep 10
    fi
    # Block-tier: the gate must refuse (rc=1), so the shim never invokes the real
    # binary. If a block-tier test ever arrives in the inbox, that is a real
    # finding — report it, do not re-run.
    live_send_expect "gmail live-fire: secret blocked, nothing sent" 1 -- $G gmail +send --to "$LIVE_EMAIL" --subject "[$MARK] block-tier test (synthetic)" --body "$(cat "$FIX/secret.txt")"
    live_send_expect "gmail live-fire: clean delivered end-to-end" 0 -- $G gmail +send --to "$LIVE_EMAIL" --subject "[$MARK] clean test (synthetic)" --body "$(cat "$FIX/clean.txt")"
    live_send_expect "gmail live-fire: figure delivered with explicit approval" 0 -- env MOCHI_EGRESS_APPROVED=1 $G gmail +send --to "$LIVE_EMAIL" --subject "[$MARK] approval-tier test (synthetic)" --body "$(cat "$FIX/figure.txt")"
  fi
  unset _profile_addr
fi

# Resolve the owner's own Messenger chat: a thread whose participants are all
# the owner. An explicit MOCHI_TEST_MESSENGER_CID must resolve to such a chat
# or the run fails closed — live-fire never sends to anyone but the owner.
SELF_CID=""
if SELF_CID="$("$M" threads --limit 50 2>/dev/null | python3 -c '
import json,sys
self_id=None; cids={}
for line in sys.stdin:
    s=line.strip()
    if not s.startswith("{"): continue
    try: d=json.loads(s)
    except Exception: continue
    data=d.get("data")
    if not isinstance(data,dict): continue
    sid=(data.get("_cache") or {}).get("self_user_id")
    if sid: self_id=str(sid)
    for t in data.get("threads") or []:
        parts=[str(p.get("id")) for p in (t.get("participants") or [])]
        cids[str(t.get("conversation_id"))]=parts
if not self_id: sys.exit(0)
wanted=sys.argv[1] if len(sys.argv)>1 else ""
def self_only(parts):
    # Exactly one participant and it is the owner. Group threads (even ones
    # whose participant list renders incompletely) can never satisfy this.
    return len(parts)==1 and parts[0]==self_id
if wanted:
    parts=cids.get(wanted)
    if parts and self_only(parts): print(wanted)
    else: sys.exit(2)
else:
    for cid,parts in cids.items():
        if parts and self_only(parts): print(cid); break
' "${MOCHI_TEST_MESSENGER_CID:-}")"; then
  if [ -n "$SELF_CID" ]; then
    wdetail "live-fire target: owner's own Messenger chat ($SELF_CID)"
    live_send_expect "messenger live-fire: clean delivered to self" 0 -- $M send --cid "$SELF_CID" --text-stdin < "$FIX/clean.txt"
    live_send_expect "messenger live-fire: secret blocked, nothing sent" 1 -- $M send --cid "$SELF_CID" --text-stdin < "$FIX/secret2.txt"
  else
    bad "live-fire: no owner-only Messenger chat found" "the Messenger path was not exercised" "send yourself one message so an owner-only chat exists, then re-run. Live-fire fails closed on coverage loss — it never reports CLEAN for a path it did not test."
  fi
else
  bad "live-fire: MOCHI_TEST_MESSENGER_CID does not resolve to the owner's own chat" "" "point it at the conversation id of a chat containing only the owner, or unset it for auto-discovery. Live-fire never sends to anyone but the owner."
fi
fi

end_suite

# ------------------------------------------------------- C. static coverage
begin_suite "C" "Attack-surface coverage (static checks)"
if [ -f "$AGENTS_FILE" ]; then
  grep -q "bin/shims" "$AGENTS_FILE" && ok "agent manual mandates shim PATH" || bad "agent manual missing shim mandate" "" "add the shim-PATH export mandate to the agent manual (see the memory skill's references/data-protection.md), then re-run this audit."
  grep -q "brief-gate" "$AGENTS_FILE" && ok "agent manual mandates brief gating" || bad "agent manual missing brief-gate mandate" "" "add the brief-gate mandate to the agent manual, then re-run this audit."
else skip "agent manual not found" "$AGENTS_FILE"; fi
[ -f "$MEM_SKILL/references/subagent-briefing.md" ] && ok "briefing policy reference exists" || bad "references/subagent-briefing.md missing" "" "restore it from the muse-memory repo, then re-run this audit."
grep -q "Free-share zones" "$MEM_SKILL/references/data-protection.md" 2>/dev/null && ok "free-share zones defined in data-protection.md" || bad "data-protection.md missing free-share zones" "" "restore the Free-share zones section from the muse-memory repo, then re-run this audit."
if [ -n "$CRON_DIRS" ]; then
  while IFS=: read -r d; do
    [ -n "$d" ] || continue
    total=0; wired=0
    while IFS= read -r f; do
      total=$((total+1))
      grep -q 'bin/shims:$PATH' "$f" && wired=$((wired+1))
    done < <(find "$d" -name '*.md' 2>/dev/null)
    if [ "$total" -eq 0 ]; then skip "no prompt files in $d" "empty"
    elif [ "$wired" -eq "$total" ]; then ok "cron prompts in $d wire shim PATH ($wired/$total)"
    else bad "cron prompts in $d missing shim PATH" "$wired/$total wired" "add the shims PATH export to the unwired prompt files, then re-run this audit."; fi
  done <<< "${CRON_DIRS//:/$'\n'}"
else skip "cron prompt dirs not configured" "set MOCHI_CRON_PROMPT_DIRS"; fi
if [ "${MOCHI_MEMORY_AUDIT:-0}" = "1" ]; then
  audit_out="$("$MEM_SKILL/bin/memory-audit" 2>&1)"; arc=$?
  if [ "$arc" -eq 0 ]; then ok "memory-audit green"
  else
    detail="$(printf '%s\n' "$audit_out" | grep -E '^  (/|!)' | head -12)"
    bad "memory-audit reported findings (judge public vs private yourself)" "$detail" "classify each finding public vs private first; only private items need action. See the memory skill's references/data-protection.md."
  fi
else skip "memory-audit run" "set MOCHI_MEMORY_AUDIT=1 to include"; fi

# F. scenario coverage map: every attack-surface scenario must be mapped
map_ids="$(grep -oE '^### [A-E][0-9]+\.' "$SKILL_DIR/references/attack-surface.md" | grep -oE '[A-E][0-9]+')"
map_count="$(printf '%s\n' $map_ids | grep -c .)"
unmapped=""
for sid in $map_ids; do
  grep -q "| $sid " "$SKILL_DIR/references/test-matrix.md" || unmapped="$unmapped $sid"
done
if [ -z "$unmapped" ]; then ok "all $map_count attack-surface scenarios mapped in test-matrix.md"
else bad "scenarios missing from the coverage map:$unmapped" "" "add a row for each to references/test-matrix.md section F, then re-run this audit."; fi

# B2/B3: public repos must not contain denylisted (private) literals
DENYLIST="$PERSONAL_MEMORY_ROOT/memory/.egress-denylist"
if [ -s "$DENYLIST" ]; then
  deny_tmp="$(mktemp)"
  grep -vE '^[[:space:]]*(#|$)' "$DENYLIST" > "$deny_tmp"
  if [ -s "$deny_tmp" ]; then
    leak=""
    for repo in "$SKILL_DIR" "$MEM_SKILL"; do
      if [ -d "$repo/.git" ]; then
        hits="$(cd "$repo" && git ls-files -z | xargs -0 grep -lF -f "$deny_tmp" 2>/dev/null || true)"
        [ -n "$hits" ] && leak="${leak}${repo}: $(printf '%s' "$hits" | tr '\n' ' ')"
      fi
    done
    if [ -n "$leak" ]; then bad "denylisted literals found in public repo files" "$leak" "remove the private literals from the public repos (B2/B3 scenarios), then re-run this audit."
    else ok "no denylisted literals in public repo tracked files (B2/B3)"; fi
  else skip "denylist empty" "no literals to check"; fi
  rm -f "$deny_tmp"
else skip "no egress denylist" "$DENYLIST missing or empty"; fi

# Fixture purity: every secret-shaped token in fixtures/corpus must be a
# declared synthetic value in bin/fixtures/SYNTHETIC.txt. The denylist
# check above catches the user's real literals; this catches any other
# undeclared secret-shaped value before it can ship in a public fixture.
SYNTH="$SKILL_DIR/bin/fixtures/SYNTHETIC.txt"
SHAPES='[0-9]{3}-[0-9]{2}-[0-9]{4}|[0-9]{4}[- ][0-9]{4}[- ][0-9]{4}[- ][0-9]{4}|sk_(live|test)_[A-Za-z0-9]+|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[bpas]-[A-Za-z0-9-]+|AIza[A-Za-z0-9_-]+|ghp_[A-Za-z0-9]+|BEGIN [A-Z ]*PRIVATE KEY'
if [ -f "$SYNTH" ]; then
  undeclared=""
  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    grep -qxF "$tok" "$SYNTH" || undeclared="${undeclared}${tok} "
  done < <(grep -hoE "$SHAPES" "$SKILL_DIR"/bin/fixtures/*.txt "$SKILL_DIR/bin/adversarial-corpus.txt" 2>/dev/null | sort -u)
  if [ -n "$undeclared" ]; then bad "undeclared secret-shaped fixture values" "$undeclared" "declare each value as synthetic in bin/fixtures/SYNTHETIC.txt (after review), or remove it, then re-run this audit."
  else ok "all secret-shaped fixture values are declared synthetic"; fi
else bad "bin/fixtures/SYNTHETIC.txt missing" "" "restore it from the repo, then re-run this audit."; fi

end_suite

# ------------------------------------------------------------- D. gate log
begin_suite "D" "Gate audit-log review"
if [ -f "$REAL_LOG" ]; then
  total="$(wc -l < "$REAL_LOG")"
  printf '%s\n' "$total gate decisions logged" | wdetail
  for v in BLOCKED needs-approval approved-override; do
    n="$(grep -c "| $v$" "$REAL_LOG" 2>/dev/null || true)"
    [ "$n" -gt 0 ] && printf '%s\n' "$v: $n" | wdetail
  done
  if grep -q "| approved-override$" "$REAL_LOG"; then
    printf '%s\n' "--- overrides (need human review) ---" | wdetail
    grep "| approved-override$" "$REAL_LOG" | tail -5 | wdetail
  fi
  if grep -q "| BLOCKED$" "$REAL_LOG"; then
    printf '%s\n' "--- blocked attempts ---" | wdetail
    grep "| BLOCKED$" "$REAL_LOG" | tail -5 | wdetail
  fi
  ok "gate log reviewed"
else skip "gate log not found" "$(shorten "$REAL_LOG") (no sends attempted yet)"; fi

end_suite

# ------------------------------------------------------------- E. residuals
begin_suite "E" "Known residuals (reported, never silent)"
{
printf '%s\n' "- browser-task sends: separate VM, shims can't reach; brief-level instruction only"
printf '%s\n' "- absolute-path bypass of shims: forbidden by policy, not technically preventable"
printf '%s\n' "- voice calls: phone tool's own confirmation flow (out of text-gate scope)"
printf '%s\n' "- brief-gate runs on mandate (no syscall interception for brief text)"
} | wdetail

end_suite

rm -rf "$T"
print_summary
[ "$FAIL" -eq 0 ]
