#!/usr/bin/env bash
# leakage-audit: validate a private-memory leakage protection installation.
#
# Checks installation integrity, red-teams every gate and send path with
# synthetic payloads, statically verifies coverage of the attack surface,
# and reviews the gate audit log. Nothing is ever really sent: send-path
# tests run against fake "real" binaries via MOCHI_REAL_* overrides.
#
# Configuration (env; ~/local.env inside the skill dir is sourced if present
# and is gitignored — keep installation-specific values there):
#   PERSONAL_MEMORY_SKILL   memory skill under test (default ~/workspace/skills/personal-memory-system)
#   PERSONAL_MEMORY_ROOT    memory root passed through to the gates (default ~)
#   MOCHI_AGENTS_FILE       agent operating manual (default ~/AGENTS.md)
#   MOCHI_CRON_PROMPT_DIRS  colon-separated dirs of scheduled-job prompts (default: empty = skip)
#   MOCHI_EGRESS_LOG        gate audit log (default ~/workspace/memory-sync/egress-gate.log)
#   MOCHI_MEMORY_AUDIT=1    also run the memory skill's own memory-audit
#
# Exit 0 = all checks pass (skips don't fail). Exit 1 = at least one FAIL.
set -u

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -f "$SKILL_DIR/local.env" ] && . "$SKILL_DIR/local.env"

MEM_SKILL="${PERSONAL_MEMORY_SKILL:-$HOME/workspace/skills/personal-memory-system}"
export PERSONAL_MEMORY_ROOT="${PERSONAL_MEMORY_ROOT:-$HOME}"
AGENTS_FILE="${MOCHI_AGENTS_FILE:-$HOME/AGENTS.md}"
CRON_DIRS="${MOCHI_CRON_PROMPT_DIRS:-}"
GATE_LOG="${MOCHI_EGRESS_LOG:-$HOME/workspace/memory-sync/egress-gate.log}"
REAL_LOG="$GATE_LOG"   # the configured log; validation below uses a temp one
FIX="$SKILL_DIR/bin/fixtures"
SHIMDIR="$MEM_SKILL/bin/shims"

PASS=0; FAIL=0; SKIPPED=0
SUITE_LETTER=""; SUITE_NAME=""; sP=0; sF=0; sS=0
ROWS=""; FINDINGS=""

# Report width: override with MOCHI_REPORT_WIDTH, else terminal width,
# else a mobile-friendly 48. Clamped to [40, 76].
WIDTH="${MOCHI_REPORT_WIDTH:-}"
if [ -z "$WIDTH" ]; then WIDTH="$(tput cols 2>/dev/null || echo 48)"; fi
case "$WIDTH" in ''|*[!0-9]*) WIDTH=48;; esac
[ "$WIDTH" -lt 40 ] && WIDTH=40
[ "$WIDTH" -gt 76 ] && WIDTH=76
RULE="$(printf '─%.0s' $(seq 1 $((WIDTH-2))))"
BOLD_RULE="$(printf '═%.0s' $(seq 1 $((WIDTH-2))))"

shorten() { printf '%s' "${1//$HOME/\~}"; }   # $HOME -> ~ for display

# Wrapped check line: "  ✓ text", continuations indented.
wcheck() {
  printf '%s\n' "$*" | fold -s -w "$((WIDTH-4))" | sed 's/ *$//' | sed '1s/^/  /; 2,$s/^/    /'
}
# Wrapped detail line: hard break so evidence never scrolls sideways.
# Reads stdin or args; each logical line wraps independently.
wdetail() {
  { if [ $# -gt 0 ]; then printf '%s\n' "$*"; else cat; fi; } \
    | while IFS= read -r line; do
        printf '%s\n' "$line" | fold -w "$((WIDTH-6))" | sed 's/ *$//' | sed '1s/^/    /; 2,$s/^/      /'
      done
}

ok()   { PASS=$((PASS+1)); wcheck "✓ $(shorten "$1")"; }
bad()  { FAIL=$((FAIL+1)); wcheck "✗ $(shorten "$1")"
         FINDINGS="${FINDINGS}$(wcheck "✗ $(shorten "$1")")"$'\n'
         if [ -n "${2:-}" ]; then
           printf '%s\n' "$2" | wdetail
           FINDINGS="${FINDINGS}$(printf '%s\n' "$2" | wdetail)"$'\n'
         fi; }
skip() { SKIPPED=$((SKIPPED+1)); wcheck "– $(shorten "$1") [$(shorten "$2")]"; }

begin_suite() { # <letter> <name>
  SUITE_LETTER="$1"; SUITE_NAME="$2"; sP=$PASS; sF=$FAIL; sS=$SKIPPED
  printf '\n'
  printf '  %s. %s\n' "$1" "$2" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/     /'
  printf '  %s\n' "$RULE"
}
end_suite() {
  local p=$((PASS-sP)) f=$((FAIL-sF)) s=$((SKIPPED-sS)) label
  case "$SUITE_LETTER" in
    A) label="Install integrity";; B) label="Red-team gates";;
    C) label="Coverage checks";;   D) label="Log review";;
    *) label="Residuals";;
  esac
  printf '  %s\n' "$RULE"
  printf '    %d passed · %d failed · %d skipped\n' "$p" "$f" "$s"
  ROWS="${ROWS}${SUITE_LETTER}|${label}|${p}|${f}|${s}"$'\n'
}

print_header() {
  printf '\n  muse-leakage-guard · leakage-audit\n'
  printf '  %s\n' "$(date '+%Y-%m-%d %H:%M %Z')"
  printf '%s\n' "target: $(shorten "$MEM_SKILL")" | fold -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  printf '  %s\n' "$BOLD_RULE"
}

print_summary() {
  printf '\n  Summary\n'
  printf '  %s\n' "$RULE"
  if [ "$WIDTH" -ge 56 ]; then
    printf '  %-32s %5s %5s %5s\n' "Suite" "Pass" "Fail" "Skip"
    printf '  %s\n' "$RULE"
    while IFS='|' read -r l lab p f s; do
      [ -n "$l" ] || continue
      printf '  %-32s %5d %5d %5d\n' "$l. $lab" "$p" "$f" "$s"
    done <<< "$ROWS"
    printf '  %s\n' "$RULE"
    printf '  %-32s %5d %5d %5d\n' "Total" "$PASS" "$FAIL" "$SKIPPED"
  else
    while IFS='|' read -r l lab p f s; do
      [ -n "$l" ] || continue
      printf '  %s. %s\n' "$l" "$lab"
      printf '    %d passed · %d failed · %d skipped\n' "$p" "$f" "$s"
    done <<< "$ROWS"
    printf '  %s\n' "$RULE"
    printf '%s\n' "Total: $PASS passed · $FAIL failed · $SKIPPED skipped" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  fi
  if [ "$FAIL" -eq 0 ]; then
    if [ "$SKIPPED" -gt 0 ]; then
      v="VERDICT: CLEAN — all $PASS checks passed ($SKIPPED skipped)."
    else
      v="VERDICT: CLEAN — all $PASS checks passed."
    fi
  else
    v="VERDICT: ATTENTION — $FAIL finding(s) need review."
  fi
  printf '%s\n' "$v" | fold -s -w "$((WIDTH-2))" | sed 's/ *$//; 1s/^/  /; 2,$s/^/    /'
  if [ "$FAIL" -gt 0 ]; then
    printf '\n  Findings\n'
    printf '  %s\n' "$RULE"
    printf '%s\n' "$FINDINGS"
  fi
  printf '\n'
}

print_header

# ---------------------------------------------------------------- A. install
begin_suite "A" "Installation integrity"
for f in bin/egress-gate bin/brief-gate bin/memory-egress-check; do
  if [ -x "$MEM_SKILL/$f" ]; then ok "$f present and executable"
  else bad "$f missing or not executable"; fi
done
for f in bin/egress-gate bin/brief-gate bin/memory-egress-check bin/shims/hatch_gws_cli bin/shims/hatch_messenger_cli; do
  if bash -n "$MEM_SKILL/$f" 2>/dev/null; then ok "$f parses"
  else bad "$f has syntax errors"; fi
done
for cli in hatch_gws_cli hatch_messenger_cli; do
  if [ ! -x "$SHIMDIR/$cli" ]; then bad "shim $cli missing"; continue; fi
  resolved="$(PATH="$SHIMDIR:$PATH" command -v "$cli")"
  if [ "$resolved" = "$SHIMDIR/$cli" ]; then ok "shim $cli shadows real binary on PATH"
  else bad "shim $cli does NOT shadow (resolves to $resolved)"; fi
  real_found=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    [ "$d" = "$SHIMDIR" ] && continue
    if [ -x "$d/$cli" ]; then real_found=1; break; fi
  done <<< "${PATH//:/$'\n'}"
  if [ "$real_found" -eq 1 ]; then ok "real $cli discoverable behind shim"
  else bad "real $cli not found on PATH — shim has nothing to delegate to"; fi
done

end_suite

# ------------------------------------------------- B. red team (fake sends)
begin_suite "B" "Gate effectiveness (red team, synthetic payloads)"
T="$(mktemp -d)"
mkdir -p "$T/fakebin"
cat > "$T/fakebin/real-gws" <<'EOF'
#!/usr/bin/env bash
echo "REAL-GWS-INVOKED args: $*"
exit 0
EOF
cat > "$T/fakebin/real-msg" <<'EOF'
#!/usr/bin/env bash
echo "REAL-MSG-INVOKED args: $*"
echo "---stdin---"; cat; echo "---endstdin---"
exit 0
EOF
chmod +x "$T/fakebin"/real-*
export MOCHI_REAL_HATCH_GWS_CLI="$T/fakebin/real-gws"
export MOCHI_REAL_HATCH_MESSENGER_CLI="$T/fakebin/real-msg"
export MOCHI_EGRESS_LOG="$T/gate.log"   # keep validation out of the real log
export PATH="$SHIMDIR:$PATH"

gate_expect() { # <name> <gate:egress|brief> <fixture> <want_rc>
  local name="$1" gate="$2" fix="$3" want="$4" rc
  if [ "$gate" = brief ]; then
    "$MEM_SKILL/bin/brief-gate" --brief-file "$FIX/$fix" --task "leakage-audit:$name" >/dev/null 2>&1; rc=$?
  else
    "$MEM_SKILL/bin/egress-gate" --content-file "$FIX/$fix" --context "leakage-audit:$name" >/dev/null 2>&1; rc=$?
  fi
  if [ "$rc" -eq "$want" ]; then ok "$name (rc=$rc)"
  else bad "$name" "want rc=$want, got rc=$rc"; fi
}
send_expect() { # <name> <want_rc> <want_invoked 0|1> -- cmd...
  local name="$1" want_rc="$2" want_inv="$3"; shift 3
  [ "${1:-}" = "--" ] && shift
  local out rc inv=0
  out="$("$@" 2>&1)"; rc=$?
  case "$out" in *REAL-*-INVOKED*) inv=1;; esac
  if [ "$rc" -eq "$want_rc" ] && [ "$inv" -eq "$want_inv" ]; then ok "$name (rc=$rc invoked=$inv)"
  else bad "$name" "want rc=$want_rc invoked=$want_inv, got rc=$rc invoked=$inv :: $(printf '%s' "$out" | head -3 | tr '\n' '|')"; fi
}

for g in egress brief; do
  gate_expect "$g gate: clean passes"            "$g" clean.txt   0
  gate_expect "$g gate: fake api key blocked"   "$g" secret.txt  1
  gate_expect "$g gate: fake private key blocked" "$g" secret2.txt 1
  gate_expect "$g gate: test SSN blocked"       "$g" ssn.txt     1
  gate_expect "$g gate: test card blocked"      "$g" card.txt    1
  gate_expect "$g gate: figure needs approval"  "$g" figure.txt  2
  gate_expect "$g gate: phone needs approval"   "$g" phone.txt   2
done

G=hatch_gws_cli; M=hatch_messenger_cli
send_expect "gmail +send clean passes" 0 1 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/clean.txt")"
send_expect "gmail +send secret blocked" 1 0 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/secret.txt")"
send_expect "gmail +reply ssn blocked" 1 0 -- $G gmail +reply --message-id x --body "$(cat "$FIX/ssn.txt")"
send_expect "gmail +send figure refused w/o approval" 2 0 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/figure.txt")"
send_expect "gmail +send figure allowed with approval" 0 1 -- env MOCHI_EGRESS_APPROVED=1 $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/figure.txt")"
send_expect "gmail +send --draft with secret passes through (stays in account)" 0 1 -- $G gmail +send --to a@example.com --subject t --body "$(cat "$FIX/secret.txt")" --draft
send_expect "gmail non-send passes through" 0 1 -- $G gmail +triage --max 1

RAW_MIME="$(python3 -c "import base64,sys; sys.stdout.write(base64.urlsafe_b64encode(open('$FIX/card.txt','rb').read()).decode())")"
send_expect "raw messages.send with card in MIME blocked" 1 0 -- $G gmail users messages send --params "{\"raw\":\"$RAW_MIME\"}"

send_expect "messenger send clean passes" 0 1 -- $M send --cid '999' --text-stdin < "$FIX/clean.txt"
send_expect "messenger send secret blocked" 1 0 -- $M send --cid '999' --text-stdin < "$FIX/secret2.txt"
send_expect "messenger threads passes through" 0 1 -- $M threads --limit 1 < /dev/null

send_expect "drive permissions create refused w/o approval" 2 0 -- $G drive permissions create --params '{}'
send_expect "drive permissions create allowed with approval" 0 1 -- env MOCHI_EGRESS_APPROVED=1 $G drive permissions create --params '{}'
send_expect "drive files list passes through (free zone)" 0 1 -- $G drive files list

# stdin replay integrity: what the fake binary received must equal the fixture
out="$($M send --cid '999' --text-stdin < "$FIX/clean.txt" 2>/dev/null)"
replayed="$(printf '%s' "$out" | sed -n '/---stdin---/,/---endstdin---/p' | sed '1d;$d')"
if [ "$replayed" = "$(cat "$FIX/clean.txt")" ]; then ok "messenger stdin replayed byte-identical on allow"
else bad "messenger stdin replay mismatch"; fi

end_suite

# ------------------------------------------------------- C. static coverage
begin_suite "C" "Attack-surface coverage (static checks)"
if [ -f "$AGENTS_FILE" ]; then
  grep -q "bin/shims" "$AGENTS_FILE" && ok "agent manual mandates shim PATH" || bad "agent manual missing shim mandate"
  grep -q "brief-gate" "$AGENTS_FILE" && ok "agent manual mandates brief gating" || bad "agent manual missing brief-gate mandate"
else skip "agent manual not found" "$AGENTS_FILE"; fi
[ -f "$MEM_SKILL/references/subagent-briefing.md" ] && ok "briefing policy reference exists" || bad "references/subagent-briefing.md missing"
grep -q "Free-share zones" "$MEM_SKILL/references/data-protection.md" 2>/dev/null && ok "free-share zones defined in data-protection.md" || bad "data-protection.md missing free-share zones"
if [ -n "$CRON_DIRS" ]; then
  while IFS=: read -r d; do
    [ -n "$d" ] || continue
    total=0; wired=0
    while IFS= read -r f; do
      total=$((total+1))
      grep -q 'bin/shims:$PATH' "$f" && wired=$((wired+1))
    done < <(find "$d" -name '*.md' 2>/dev/null)
    if [ "$total" -eq 0 ]; then skip "no prompt files in $d" "empty"
    elif [ "$wired" -eq "$total" ]; then ok "cron prompts in $d wire shim PATH ($wired/$total)"
    else bad "cron prompts in $d missing shim PATH" "$wired/$total wired"; fi
  done <<< "${CRON_DIRS//:/$'\n'}"
else skip "cron prompt dirs not configured" "set MOCHI_CRON_PROMPT_DIRS"; fi
if [ "${MOCHI_MEMORY_AUDIT:-0}" = "1" ]; then
  audit_out="$("$MEM_SKILL/bin/memory-audit" 2>&1)"; arc=$?
  if [ "$arc" -eq 0 ]; then ok "memory-audit green"
  else
    detail="$(printf '%s\n' "$audit_out" | grep -E '^  (/|!)' | head -12)"
    bad "memory-audit reported findings (judge public vs private yourself)" "$detail"
  fi
else skip "memory-audit run" "set MOCHI_MEMORY_AUDIT=1 to include"; fi

end_suite

# ------------------------------------------------------------- D. gate log
begin_suite "D" "Gate audit-log review"
if [ -f "$REAL_LOG" ]; then
  total="$(wc -l < "$REAL_LOG")"
  printf '%s\n' "$total gate decisions logged" | wdetail
  for v in BLOCKED needs-approval approved-override; do
    n="$(grep -c "| $v$" "$REAL_LOG" 2>/dev/null || true)"
    [ "$n" -gt 0 ] && printf '%s\n' "$v: $n" | wdetail
  done
  if grep -q "| approved-override$" "$REAL_LOG"; then
    printf '%s\n' "--- overrides (need human review) ---" | wdetail
    grep "| approved-override$" "$REAL_LOG" | tail -5 | wdetail
  fi
  if grep -q "| BLOCKED$" "$REAL_LOG"; then
    printf '%s\n' "--- blocked attempts ---" | wdetail
    grep "| BLOCKED$" "$REAL_LOG" | tail -5 | wdetail
  fi
  ok "gate log reviewed"
else skip "gate log not found" "$(shorten "$REAL_LOG") (no sends attempted yet)"; fi

end_suite

# ------------------------------------------------------------- E. residuals
begin_suite "E" "Known residuals (reported, never silent)"
{
printf '%s\n' "- browser-task sends: separate VM, shims can't reach; brief-level instruction only"
printf '%s\n' "- absolute-path bypass of shims: forbidden by policy, not technically preventable"
printf '%s\n' "- voice calls: phone tool's own confirmation flow (out of text-gate scope)"
printf '%s\n' "- brief-gate runs on mandate (no syscall interception for brief text)"
} | wdetail

end_suite

rm -rf "$T"
print_summary
[ "$FAIL" -eq 0 ]
